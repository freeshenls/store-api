<%= element_view_for(product_card, class: "product-card") do |el| %>
  <%
    slug = product_card.value_for('slug').to_s.strip
    product_link = if slug.present?
                     "/products/#{slug}"
                   elsif product_card.value_for('title').present?
                     "/products/#{product_card.value_for('title').to_s.parameterize}"
                   else
                     "/products/#{product_card.id}"
                   end
  %>

  <div class="product-image-wrapper">
    <a href="<%= product_link %>" class="product-image-link" style="display: block; width: 100%; height: 100%;">
      <%= el.render :image, { size: "300x300" } %>
    </a>

    
    <% if product_card.value_for('badge').present? %>
      <span class="product-badge"><%= el.render :badge %></span>
    <% end %>
    
    <a href="<%= product_link %>" class="product-quick-view" style="text-decoration: none;">
      <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span>
      <span>View Details</span>
    </a>
  </div>
  
  <div class="product-info">
    <% unless local_assigns[:hide_category] %>
      <span class="product-cat"><%= el.render :category %></span>
    <% end %>
    <h3 class="product-title" style="margin: 6px 0;">
      <a href="<%= product_link %>" style="color: var(--text-dark); text-decoration: none; transition: color 0.2s ease;">
        <%= el.render :title %>
      </a>
    </h3>
    
    <div class="product-bottom">
      <div class="product-price">
        <span class="price-now"><%= el.render :price %></span>
        <% if product_card.value_for('old_price').present? %>
          <span class="price-old"><%= el.render :old_price %></span>
        <% end %>
      </div>
      <span class="product-qty"><%= el.render :min_qty %></span>
    </div>
  </div>
<% end %>

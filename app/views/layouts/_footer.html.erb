<%
  marketing_page = local_assigns[:marketing_page] || false
  show_quick_links = !controller_name.in?(['products', 'taxons'])
%>

<footer id="contact" class="scroll-mt-24 border-t <%= marketing_page ? 'bg-black border-hairline-dark text-white' : 'bg-white border-hairline-light text-black shadow-halos' %> py-16 px-6 sm:px-12 mt-16 font-sans">
  <div class="max-w-7xl mx-auto grid grid-cols-1 <%= show_quick_links ? 'md:grid-cols-3' : 'md:grid-cols-2' %> gap-12">
    <!-- Column 1: Branding -->
    <div class="flex flex-col gap-4">
      <span class="text-xl font-bold tracking-wider select-none uppercase">
        <span class="<%= marketing_page ? 'text-white' : 'text-black' %>">ZEVI</span> <span class="<%= marketing_page ? 'text-link-cool-1' : 'text-shade-50' %>">PROMOTION</span>
      </span>
      <p class="<%= marketing_page ? 'text-link-cool-2' : 'text-shade-60' %> text-xs leading-relaxed max-w-sm">
        Your trusted partner for promotional products and custom corporate gifts. Quality branding solutions for your business.
      </p>
    </div>

    <% if show_quick_links %>
      <!-- Column 2: Quick Links -->
      <div class="flex flex-col gap-4">
        <h3 class="text-xs font-bold uppercase tracking-wider <%= marketing_page ? 'text-white' : 'text-black' %>">Quick Links</h3>
        <ul class="flex flex-col gap-3 text-xs <%= marketing_page ? 'text-link-cool-2' : 'text-shade-60' %>">
          <li>
            <%= link_to "Home", root_path, class: "hover:#{marketing_page ? 'text-white' : 'text-black'} transition-colors" %>
          </li>
          <li>
            <%= link_to "Products", products_path, class: "hover:#{marketing_page ? 'text-white' : 'text-black'} transition-colors" %>
          </li>
          <li>
            <a href="/#about" class="hover:#{marketing_page ? 'text-white' : 'text-black'} transition-colors">About Us</a>
          </li>
          <li>
            <a href="/#contact" class="hover:#{marketing_page ? 'text-white' : 'text-black'} transition-colors">Contact</a>
          </li>
        </ul>
      </div>
    <% end %>

    <!-- Column 3: Contact Us -->
    <div class="flex flex-col gap-4">
      <h3 class="text-xs font-bold uppercase tracking-wider <%= marketing_page ? 'text-white' : 'text-black' %>">Contact Us</h3>
      <ul class="flex flex-col gap-4 text-xs <%= marketing_page ? 'text-link-cool-2' : 'text-shade-60' %>">
        <li class="flex items-start gap-3">
          <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>7 Copperfield Road, Coventry, UK CV2 4AQ</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <a href="tel:2812355575" class="hover:#{marketing_page ? 'text-white' : 'text-black'} transition-colors">(281) 235-5575</a>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <a href="mailto:sales@digitalmonkey.com" class="hover:#{marketing_page ? 'text-white' : 'text-black'} transition-colors">sales@digitalmonkey.com</a>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
          </svg>
          <a href="https://www.zevipromotion.com" target="_blank" class="hover:#{marketing_page ? 'text-white' : 'text-black'} transition-colors">www.zevipromotion.com</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Copyright and separator -->
  <div class="max-w-7xl mx-auto border-t <%= marketing_page ? 'border-hairline-dark' : 'border-hairline-light' %> mt-12 pt-8 text-center text-xs <%= marketing_page ? 'text-link-cool-2' : 'text-shade-50' %>">
    <p>&copy; 2026 ZEVI Promotion Co Ltd. All rights reserved.</p>
  </div>
</footer>

      <!-- Pagination Controls (Always displayed by default) -->
      <div class="pagination-wrapper" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--light-border);">
        <!-- Previous Page Link -->
        <% if @current_page > 1 %>
          <a href="/products?page=<%= @current_page - 1 %>&per_page=<%= @per_page %><%= "&category=#{u(params[:category])}" if params[:category].present? %><%= "&q=#{u(params[:q])}" if params[:q].present? %>" class="pagination-btn" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); color: var(--text-dark); background: var(--light-surface); transition: var(--transition);">
            <span class="material-symbols-outlined" style="font-size: 20px;">chevron_left</span>
          </a>
        <% else %>
          <div class="pagination-btn disabled" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); color: #cbd5e1; background: #f1f5f9; cursor: not-allowed; opacity: 0.6;">
            <span class="material-symbols-outlined" style="font-size: 20px;">chevron_left</span>
          </div>
        <% end %>

        <!-- Page Numbers -->
        <% (1..@total_pages).each do |num| %>
          <% is_active = num == @current_page %>
          <% if is_active %>
            <div class="pagination-btn active" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--primary); border-radius: var(--radius-sm); color: var(--text-light); background: var(--primary); font-weight: 700; font-family: var(--font-display);"><%= num %></div>
          <% else %>
            <a href="/products?page=<%= num %>&per_page=<%= @per_page %><%= "&category=#{u(params[:category])}" if params[:category].present? %><%= "&q=#{u(params[:q])}" if params[:q].present? %>" class="pagination-btn" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); color: var(--text-dark); background: var(--light-surface); font-weight: 600; font-family: var(--font-display); transition: var(--transition);" onmouseover="this.style.background='var(--primary-light)'; this.style.color='var(--primary)'" onmouseout="this.style.background='var(--light-surface)'; this.style.color='var(--text-dark)'"><%= num %></a>
          <% end %>
        <% end %>

        <!-- Next Page Link -->
        <% if @current_page < @total_pages %>
          <a href="/products?page=<%= @current_page + 1 %>&per_page=<%= @per_page %><%= "&category=#{u(params[:category])}" if params[:category].present? %><%= "&q=#{u(params[:q])}" if params[:q].present? %>" class="pagination-btn" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); color: var(--text-dark); background: var(--light-surface); transition: var(--transition);">
            <span class="material-symbols-outlined" style="font-size: 20px;">chevron_right</span>
          </a>
        <% else %>
          <div class="pagination-btn disabled" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); color: #cbd5e1; background: #f1f5f9; cursor: not-allowed; opacity: 0.6;">
            <span class="material-symbols-outlined" style="font-size: 20px;">chevron_right</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%= render "shared/footer" %>


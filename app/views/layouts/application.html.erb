<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Zevi Promotion - Custom Swag & Promotional Products" %></title>
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Welcome to Zevi Promotion - Your ultimate destination for premium custom promotional products, corporate gifts, embroidered apparel, and graphic artwork services." %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Zevi Promotion">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Include locally hosted font definitions (Inter, Outfit, Material Symbols Outlined) %>
    <%= stylesheet_link_tag "fonts", "data-turbo-track": "reload" %>
    
    <%# Include locally hosted Air Datepicker styles %>
    <%= stylesheet_link_tag "air_datepicker", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "digital_monkey", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      /* Prevent flash of unstyled text (FOUT) for Google Material Symbols */
      .material-symbols-outlined {
        font-family: 'Material Symbols Outlined';
        display: inline-block;
        opacity: 0;
      }
    </style>
  </head>

  <body>
    <%= yield %>
  </body>
</html>

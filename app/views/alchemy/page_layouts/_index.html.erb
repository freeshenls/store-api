      <img src="<%= image_path('about_team.jpg') %>" alt="About Zevi Promotion Team">
    </div>
  </div>
</section>

<%# Interactive Alchemy Preview Mode Editor Panel %>
<% if respond_to?(:alchemy_preview_mode?) && alchemy_preview_mode? %>
  <div style="background: rgba(12, 58, 107, 0.03); border: 2px dashed var(--primary); padding: 32px 24px; border-radius: var(--radius-lg); margin: 40px auto; max-width: 900px; text-align: center; font-family: var(--font-body); box-shadow: var(--shadow-lg);">
    <img src="<%= image_path('logo_zevi.png') %>" style="height: 60px; width: 60px; margin: 0 auto 16px auto; border-radius: 50%; background-color: #ffffff; padding: 4px; object-fit: contain; box-shadow: var(--shadow-sm);">
    <h3 style="color: var(--primary); font-family: var(--font-display); font-weight: 800; font-size: 22px; margin-bottom: 8px;">Zevi Promotion CMS Editor</h3>
    <p style="font-size: 14px; color: var(--text-muted); margin-bottom: 24px; max-width: 600px; margin-left: auto; margin-right: auto; line-height: 1.6;">
      Welcome to your live visual editor! Click the left panel inside the CMS dashboard to add, customize, or re-order carousel slides, category banners, or individual product cards dynamically. 
      <br>
      <strong style="color: var(--text-dark);">Note:</strong> If you have not created any dynamic elements yet, the system seamlessly displays your stunning default merchandise fallbacks to keep the site beautiful!
    </p>
    <div style="background: var(--light-surface); border: 1px solid var(--light-border); border-radius: var(--radius-md); padding: 20px; text-align: left;">
      <h4 style="font-family: var(--font-display); font-weight: 700; color: var(--text-dark); margin-bottom: 12px; border-bottom: 1px solid var(--light-border); padding-bottom: 8px;">Active CMS Editable Elements:</h4>
      <%= render_elements %>
    </div>
  </div>
<% end %>

<%= render "shared/footer" %>

<!-- Floating Email Widget -->
<div id="floating-email-widget" class="floating-email-box minimized">
  <a href="mailto:<%= email_address %>" class="widget-action-btn email-btn">
    <span class="material-symbols-outlined">mail</span>
    <span class="btn-label">Email</span>
  </a>
  <button type="button" id="widget-toggle-btn" class="widget-action-btn toggle-btn">
    <span class="material-symbols-outlined toggle-icon">keyboard_arrow_down</span>
    <span class="btn-label toggle-label">Hide</span>
  </button>
</div>

<button type="button" id="floating-email-collapsed" class="floating-email-collapsed-btn" style="display: flex;">
  <span class="material-symbols-outlined">mail</span>
</button>



<%
  products_page = Alchemy::Page.find_by(page_layout: 'products') || Alchemy::Page.find_by(id: 2)
  if products_page
    all_products = products_page.elements.where(name: 'product_card')
    categories = all_products.map { |p| p.value_for('category').to_s.strip }.uniq.reject(&:empty?)
  else
    categories = []
  end

  categories = [
    "Apparel",
    "Desk Accessories",
    "Drinkware",
    "Fidgets",
    "Novelties",
    "Gifts",
    "Bags & Totes",
    "Technology"
  ] if categories.empty?

  # Retrieve unified contact details from Alchemy Layout Pages (Global Pages)
  global_page = Alchemy::Page.layoutpages.find_by(page_layout: 'global_layout')

  header_contact = global_page&.elements&.find_by(name: 'header_contact')
  
  # Fallback to local page element if global is not yet created/published in the editor
  header_contact ||= @page.elements.find_by(name: 'header_contact') if @page
  
  phone_number = header_contact&.value_for('phone').presence || "(714) 857-0010"
  email_address = header_contact&.value_for('email').presence || "sales@zevipromotion.com"
%>

<%= render "shared/top_contact_bar" %>
<%= render "shared/main_header" %>

<!-- Hero Layout Section -->
<section class="hero-layout-section">
  <div class="container-custom hero-grid">
    <!-- Left Sidebar Categories -->
    <aside class="categories-sidebar homepage-sidebar">
      <div class="sidebar-title">
        <span class="material-symbols-outlined" style="font-size: 20px; color: var(--primary);">grid_view</span>
        <span>Categories</span>
      </div>
      <ul class="sidebar-menu-list">
        <li class="sidebar-menu-item">
          <a href="/products">
            <span>All Products</span>
            <span class="material-symbols-outlined" style="font-size: 16px;">chevron_right</span>
          </a>
        </li>
        <% categories.each do |cat| %>
          <li class="sidebar-menu-item">
            <a href="/products?category=<%= u(cat) %>">
              <span><%= cat %></span>
              <span class="material-symbols-outlined" style="font-size: 16px;">chevron_right</span>
            </a>
          </li>
        <% end %>
      </ul>
    </aside>

    <!-- Right Hero Carousel -->
    <div class="carousel-wrapper">
      <div class="carousel-slides">
        <% slides = @page.elements.where(name: 'carousel_slide') %>
        <% if slides.any? %>
          <% slides.each_with_index do |slide, index| %>
            <%= render slide, active: (index == 0), fallback_image: (index == 1 ? 'slide_spirit.png' : 'slide_apparel.png') %>
          <% end %>
        <% else %>
          <!-- Fallback static slide 1 -->
          <div class="carousel-slide active" id="slide-1">
            <img src="<%= image_path('slide_apparel.png') %>" class="slide-bg" alt="Apparel Collection">
            <div class="carousel-overlay">
              <div class="carousel-content">
                <h3>Polos, Workwear, T-Shirts, & More!</h3>
                <h1>Shop Apparel</h1>
                <p>Premium embroidered apparel and printed sportswear designed to make your brand stand out in any team event or corporate setting.</p>
                <a href="/products" class="btn-primary">
                  <span>Shop Now</span>
                  <span class="material-symbols-outlined">arrow_forward</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Fallback static slide 2 -->
          <div class="carousel-slide" id="slide-2">
            <img src="<%= image_path('slide_spirit.png') %>" class="slide-bg" alt="Spirit Collection">
            <div class="carousel-overlay">
              <div class="carousel-content">
                <h3>Go Team!</h3>
                <h1>Shop Spirit</h1>
                <p>Support your team, event, or school with custom caps, wristbands, notebooks, custom-printed bags, and custom swag kits.</p>
                <a href="/products" class="btn-primary">
                  <span>Shop Now</span>
                  <span class="material-symbols-outlined">arrow_forward</span>
                </a>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Navigation Arrows -->
      <button class="carousel-nav carousel-prev" id="prev-btn">
        <span class="material-symbols-outlined">chevron_left</span>
      </button>
      <button class="carousel-nav carousel-next" id="next-btn">
        <span class="material-symbols-outlined">chevron_right</span>
      </button>

      <!-- Carousel Dots -->
      <div class="carousel-dots">
        <% if slides.any? %>
          <% slides.each_with_index do |slide, index| %>
            <div class="carousel-dot <%= 'active' if index == 0 %>" data-slide="<%= index + 1 %>"></div>
          <% end %>
        <% else %>
          <div class="carousel-dot active" data-slide="1"></div>
          <div class="carousel-dot" data-slide="2"></div>
        <% end %>
      </div>
    </div>
  </div>
</section>


<%= element_view_for(about_us, class: "section-padding about-section", id: "about") do |el| %>
  <div class="container-custom about-container">
    <div class="about-content">
      <h2><%= el.render :title %></h2>
      <p><%= el.render :description_1 %></p>
      <p><%= el.render :description_2 %></p>
      <p style="font-weight: 700; color: var(--primary); font-family: var(--font-display); font-size: 16px;">
        <%= el.render :description_3 %>
      </p>
    </div>
    <div class="about-image-wrapper">
      <%= el.render :image, { size: "600x400" } %>
    </div>
  </div>
<% end %>

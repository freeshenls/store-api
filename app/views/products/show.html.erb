<%
  # Set up category fallbacks in case the database is in an empty state
  categories = @categories.any? ? @categories : [
    "Apparel",
    "Desk Accessories",
    "Drinkware",
    "Fidgets",
    "Novelties",
    "Gifts",
    "Bags & Totes",
    "Technology"
  ]

  # Resolve product info
  title = @product.value_for('title')
  category = @product.value_for('category')
  price = @product.value_for('price')
  old_price = @product.value_for('old_price')
  badge = @product.value_for('badge')
  min_qty = @product.value_for('min_qty')
  
  # Resolve default fallback images based on category
  cat_down = category.to_s.downcase
  default_img = if cat_down.include?('apparel')
                  'slide_apparel.png'
                elsif cat_down.include?('fidget') || cat_down.include?('novelty')
                  'card_fidgets.png'
                elsif cat_down.include?('gift')
                  'card_gifts.png'
                else
                  'card_drinkware.png'
                end

  # Retrieve unified contact details from Alchemy Layout Pages (Global Pages)
  global_page = Alchemy::Page.layoutpages.find_by(page_layout: 'global_layout')

  header_contact = global_page&.elements&.find_by(name: 'header_contact')
  
  # Fallback to local page element if global is not yet created/published in the editor
  header_contact ||= @page.elements.find_by(name: 'header_contact') if @page
  
  phone_number = header_contact&.value_for('phone').presence || "(714) 857-0010"
  email_address = header_contact&.value_for('email').presence || "sales@zevipromotion.com"
%>

<!-- Top Utility Contact Bar -->
<div class="top-contact-bar">
  <div class="container-custom">
    <div class="contact-info">
      <a href="tel:<%= phone_number %>" class="contact-item">
        <span class="icon material-symbols-outlined">call</span>
        <span><%= phone_number %></span>
      </a>
      <a href="mailto:<%= email_address %>" class="contact-item">
        <span class="icon material-symbols-outlined">mail</span>
        <span><%= email_address %></span>
      </a>
    </div>
  </div>
</div>

<!-- Main Header & Navbar -->
<header class="main-header">
  <div class="container-custom navbar-container">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo">
      <img src="<%= image_path('logo_zevi.png') %>" alt="Zevi Promotion Logo">
      <span>Zevi <span class="highlight">Promotion</span></span>
    </a>

    <!-- Search Form -->
    <form class="navbar-search" action="/products" method="GET">
      <span class="search-icon material-symbols-outlined">search</span>
      <input type="text" name="q" placeholder="Search products...">
      <button type="submit" class="search-submit">Search</button>
    </form>

    <!-- Desktop Navigation Menu -->
    <nav class="navbar-menu">
      <div class="navbar-link dropdown-trigger">
        <span>Categories</span>
        <span class="material-symbols-outlined" style="font-size: 16px;">keyboard_arrow_down</span>
        <div class="dropdown-menu-list">
          <a href="/products" class="dropdown-item">All Products</a>
          <% categories.each do |cat| %>
            <a href="/products?category=<%= u(cat) %>" class="dropdown-item"><%= cat %></a>
          <% end %>
        </div>
      </div>
      <a href="/" class="navbar-link">Home</a>
      <a href="/products" class="navbar-link active">Shop Now</a>
      <a href="javascript:void(0)" class="navbar-link">About</a>
      <a href="#footer" class="navbar-link">Contact</a>
    </nav>

    <!-- Mobile menu toggle -->
    <button class="mobile-menu-toggle" id="mobile-menu-btn">
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>

  <!-- Mobile Navigation Accordion Menu -->
  <div id="mobile-dropdown-menu" class="mobile-accordion-menu">
    <div class="mobile-menu-links">
      <a href="/" class="mobile-menu-link">Home</a>
      <a href="/products" class="mobile-menu-link">Product Catalog</a>
      <a href="javascript:void(0)" class="mobile-menu-link">About</a>
      <a href="#footer" class="mobile-menu-link">Contact</a>
    </div>
  </div>
</header>


<!-- Main Detail Page Section -->
<main class="section-padding" style="background: linear-gradient(180deg, rgba(242, 101, 34, 0.02) 0%, rgba(15, 23, 42, 0) 100%);">
  <div class="container-custom">
    <!-- Breadcrumb -->
    <div style="margin-bottom: 24px; font-size: 14px; font-weight: 500; color: var(--text-muted);">
      <a href="/" style="color: var(--text-muted); text-decoration: none; hover: color: var(--primary);">Home</a>
      <span style="margin: 0 8px;">/</span>
      <a href="/products" style="color: var(--text-muted); text-decoration: none;">Catalog</a>
      <span style="margin: 0 8px;">/</span>
      <a href="/products?category=<%= u(category) %>" style="color: var(--text-muted); text-decoration: none;"><%= category %></a>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--text-dark); font-weight: 600;"><%= title %></span>
    </div>

    <!-- Details Grid wrapped in element_view_for to enable inline editing -->
    <%= element_view_for(@product) do |el| %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; margin-bottom: 60px; align-items: start;">
        
        <!-- Left Column: Product Image Frame -->
        <div style="background: var(--light-surface); border: 1px solid var(--light-border); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-md); position: relative; display: flex; align-items: center; justify-content: center; min-height: 400px; backdrop-filter: blur(8px);">
          <% if @product.value_for('image').present? %>
            <%= el.render :image, { size: "600x600" }, style: "max-width: 100%; height: auto; border-radius: var(--radius-md); object-fit: contain;" %>
          <% else %>
            <img src="<%= image_path(default_img) %>" alt="<%= title %>" style="max-width: 100%; height: auto; border-radius: var(--radius-md); object-fit: contain;">
          <% end %>
          
          <% if badge.present? %>
            <span style="position: absolute; top: 20px; left: 20px; background: var(--primary); color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 12px; text-transform: uppercase; padding: 6px 14px; border-radius: var(--radius-full); box-shadow: var(--shadow-sm); z-index: 2;">
              <%= el.render :badge %>
            </span>
          <% end %>
        </div>

        <!-- Right Column: Product Info & Quote Form -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
          <div>
            <span style="display: inline-block; background: rgba(242, 101, 34, 0.08); color: var(--primary); font-family: var(--font-display); font-weight: 700; font-size: 12px; text-transform: uppercase; padding: 4px 12px; border-radius: var(--radius-sm); margin-bottom: 12px; letter-spacing: 0.5px;">
              <%= el.render :category %>
            </span>
            <h1 style="font-family: var(--font-display); font-size: 36px; font-weight: 800; color: var(--text-dark); line-height: 1.2; margin: 0 0 16px 0;">
              <%= el.render :title %>
            </h1>
            
            <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 8px;">
              <span style="font-family: var(--font-display); font-size: 32px; font-weight: 800; color: var(--primary);">
                <%= el.render :price %>
              </span>
              <% if old_price.present? %>
                <span style="font-family: var(--font-display); font-size: 20px; font-weight: 600; color: var(--text-muted); text-decoration: line-through;">
                  <%= el.render :old_price %>
                </span>
              <% end %>
            </div>
            
            <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 12px;">
              <% if min_qty.present? %>
                <div style="display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--text-muted); background: var(--light-surface); border: 1px solid var(--light-border); padding: 6px 16px; border-radius: var(--radius-md);">
                  <span class="material-symbols-outlined" style="font-size: 18px; color: var(--primary);">inventory_2</span>
                  <span><%= el.render :min_qty %></span>
                </div>
              <% end %>

              <% if respond_to?(:alchemy_preview_mode?) && alchemy_preview_mode? %>
                <div style="display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; color: var(--text-muted); background: rgba(242, 101, 34, 0.04); border: 1px dashed rgba(242, 101, 34, 0.3); padding: 6px 16px; border-radius: var(--radius-md);">
                  <span><strong>Slug:</strong> /products/<%= el.render :slug %></span>
                </div>
              <% end %>
            </div>
          </div>

          <hr style="border: 0; border-top: 1px solid var(--light-border); margin: 8px 0;">

          <!-- Inquiry Form -->
          <div style="background: rgba(242, 101, 34, 0.02); border: 1px solid rgba(242, 101, 34, 0.1); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm); backdrop-filter: blur(8px);">
            <h3 style="font-family: var(--font-display); font-size: 18px; font-weight: 800; color: var(--text-dark); margin: 0 0 16px 0; display: flex; align-items: center; gap: 8px;">
              <span class="material-symbols-outlined" style="color: var(--primary);">request_quote</span>
              <span>Request a Custom Quote</span>
            </h3>
            
            <form style="display: flex; flex-direction: column; gap: 16px;" onsubmit="alert('Thank you! Your quote request has been submitted. Our team will contact you shortly.'); return false;">
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
                <div style="display: flex; flex-direction: column; gap: 6px;">
                  <label style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Full Name</label>
                  <input type="text" required placeholder="John Doe" style="padding: 10px 14px; border: 1px solid var(--light-border); border-radius: var(--radius-md); font-size: 14px; width: 100%; transition: border-color 0.2s;" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='var(--light-border)'">
                </div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                  <label style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Business Email</label>
                  <input type="email" required placeholder="name@company.com" style="padding: 10px 14px; border: 1px solid var(--light-border); border-radius: var(--radius-md); font-size: 14px; width: 100%; transition: border-color 0.2s;" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='var(--light-border)'">
                </div>
              </div>
              
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
                <div style="display: flex; flex-direction: column; gap: 6px;">
                  <label style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Target Quantity</label>
                  <input type="number" required min="1" placeholder="100" style="padding: 10px 14px; border: 1px solid var(--light-border); border-radius: var(--radius-md); font-size: 14px; width: 100%; transition: border-color 0.2s;" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='var(--light-border)'">
                </div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                  <label style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Branding Option</label>
                  <select style="padding: 10px 14px; border: 1px solid var(--light-border); border-radius: var(--radius-md); font-size: 14px; width: 100%; transition: border-color 0.2s;" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='var(--light-border)'">
                    <option>Screen Printed Logo</option>
                    <option>Laser Engraved Logo</option>
                    <option>Embroidered Branding</option>
                    <option>Full Color Custom Print</option>
                    <option>No Logo (Blank Stock)</option>
                  </select>
                </div>
              </div>
              
              <button type="submit" class="btn-primary" style="width: 100%; border: none; cursor: pointer; padding: 12px; justify-content: center; font-size: 15px;">
                <span>Submit Inquiry</span>
                <span class="material-symbols-outlined">arrow_forward</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Product Specifications Sheet -->
    <div style="background: var(--light-surface); border: 1px solid var(--light-border); border-radius: var(--radius-lg); padding: 32px; box-shadow: var(--shadow-sm); margin-bottom: 60px;">
      <h2 style="font-family: var(--font-display); font-weight: 800; font-size: 24px; color: var(--text-dark); margin: 0 0 20px 0; border-bottom: 2px solid var(--primary); padding-bottom: 8px; display: inline-block;">Product Details & Specifications</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px;">
        <div>
          <h4 style="font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--text-dark); margin: 0 0 12px 0; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined" style="color: var(--primary);">workspace_premium</span>
            <span>Premium Quality Guaranteed</span>
          </h4>
          <p style="font-size: 14px; color: var(--text-muted); line-height: 1.6; margin: 0;">
            All of our custom merchandise is sourced from premium materials. We utilize advanced print technologies to ensure your brand's color accuracy, sharpness, and long-lasting durability on any surface.
          </p>
        </div>
        <div>
          <h4 style="font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--text-dark); margin: 0 0 12px 0; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined" style="color: var(--primary);">schedule</span>
            <span>Production & Turnaround</span>
          </h4>
          <p style="font-size: 14px; color: var(--text-muted); line-height: 1.6; margin: 0;">
            Standard production time is typically 5-10 business days from artwork approval. Rushed production options are available on select categories. Shipping times will vary based on your location and carrier selection.
          </p>
        </div>
        <div>
          <h4 style="font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--text-dark); margin: 0 0 12px 0; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined" style="color: var(--primary);">palette</span>
            <span>Artwork & Setup Guidelines</span>
          </h4>
          <p style="font-size: 14px; color: var(--text-muted); line-height: 1.6; margin: 0;">
            Please submit your logo files in vector format (.AI, .EPS, or editable PDF) with fonts outlined. Our graphic design team will provide a digital proof for your final review and signature prior to manufacturing.
          </p>
        </div>
      </div>
    </div>

    <!-- Related Products Ribbon -->
    <% if @related_products.any? %>
      <div style="margin-top: 80px;">
        <h2 style="font-family: var(--font-display); font-size: 26px; font-weight: 800; color: var(--text-dark); margin-bottom: 24px; text-align: center; position: relative;">
          You May Also Like
          <span style="display: block; width: 60px; height: 3px; background: var(--primary); margin: 8px auto 0 auto; border-radius: var(--radius-full);"></span>
        </h2>
        
        <div class="product-grid">
          <% @related_products.each do |product| %>
            <%= render "alchemy/elements/product_card", product_card: product %>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</main>

<!-- Footer Section -->
<footer class="dcFooter" id="footer">
  <div class="container-custom footer-grid">
    <!-- Brand Info -->
    <div class="footer-col-brand">
      <div class="footer-logo">
        <img src="<%= image_path('logo_zevi.png') %>" alt="Zevi Promotion Logo">
        <span>Zevi <span>Promotion</span></span>
      </div>
      <p>Your one-stop source for premium promotional apparel, corporate gifts, spirit items, and custom-branded marketing giveaways.</p>
      <div style="font-size: 12px; color: #64748b;">Powered by Alchemy CMS & Rails 8.1</div>
    </div>

    <!-- Sitemap Navigation Links -->
    <div>
      <div class="footer-col-title">Quick Links</div>
      <ul class="footer-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products">Product Catalog</a></li>
        <li><a href="/#about">About Us</a></li>
        <li><a href="#footer">Contact Us</a></li>
      </ul>
    </div>

    <!-- Contact address -->
    <div>
      <div class="footer-col-title">Contact Us</div>
      <address class="footer-contact-address">
        <div class="footer-contact-item" style="font-weight: 700; color: var(--text-light);">
          <span>Zevi Promotions Inc.</span>
        </div>
        <div class="footer-contact-item">
          <span class="icon material-symbols-outlined">business</span>
          <span>1434 W Taft Ave, Suite 335<br>Orange, CA 92865</span>
        </div>

        <div class="footer-contact-item">
          <span class="icon material-symbols-outlined">call</span>
          <span><%= phone_number %></span>
        </div>
        <div class="footer-contact-item">
          <span class="icon material-symbols-outlined">mail</span>
          <a href="mailto:<%= email_address %>"><%= email_address %></a>
        </div>
      </address>
    </div>
  </div>

  <div class="container-custom footer-bottom">
    <p>&copy; <%= Time.current.year %> Zevi Promotion. All rights reserved.</p>
    <div class="footer-bottom-links">
      <a href="javascript:void(0)">Privacy Policy</a>
      <a href="javascript:void(0)">Terms & Conditions</a>
    </div>
  </div>
</footer>

<!-- Floating Email Widget -->
<div id="floating-email-widget" class="floating-email-box minimized">
  <a href="mailto:<%= email_address %>" class="widget-action-btn email-btn">
    <span class="material-symbols-outlined">mail</span>
    <span class="btn-label">Email</span>
  </a>
  <button type="button" id="widget-toggle-btn" class="widget-action-btn toggle-btn">
    <span class="material-symbols-outlined toggle-icon">keyboard_arrow_down</span>
    <span class="btn-label toggle-label">Hide</span>
  </button>
</div>

<button type="button" id="floating-email-collapsed" class="floating-email-collapsed-btn" style="display: flex;">
  <span class="material-symbols-outlined">mail</span>
</button>



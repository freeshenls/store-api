<!DOCTYPE html>
<html>
  <head>
    <%= render "alchemy/pages/meta_data" %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Store Api">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Include locally hosted font definitions (Inter, Outfit, Material Symbols Outlined) %>
    <%= stylesheet_link_tag "fonts", "data-turbo-track": "reload" %>

    <%# Include locally hosted Air Datepicker CSS & JS %>
    <%= stylesheet_link_tag "air-datepicker", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "air-datepicker", "data-turbo-track": "reload" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "digital_monkey", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>

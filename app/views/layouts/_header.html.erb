<%
  categories = taxonomies.first
  marketing_page = local_assigns[:marketing_page] || false
%>

<div class="w-full flex flex-col font-sans">
  <!-- Top Contact Bar -->
  <div class="<%= marketing_page ? 'bg-black border-b border-hairline-dark text-link-cool-1' : 'bg-[#fbfbf5] border-b border-hairline-light text-shade-50' %> py-2 px-4 sm:px-8 flex flex-wrap justify-center sm:justify-start items-center text-xs tracking-wider uppercase gap-6 z-30">
    <a href="tel:2812355575" class="flex items-center gap-2 hover:text-<%= marketing_page ? 'white' : 'black' %> transition-colors">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
      </svg>
      (281) 235-5575
    </a>
    <a href="mailto:sales@digitalmonkey.com" class="flex items-center gap-2 hover:text-<%= marketing_page ? 'white' : 'black' %> transition-colors">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      sales@digitalmonkey.com
    </a>
  </div>

  <!-- Main Brand Header -->
  <header class="<%= marketing_page ? 'bg-black border-b border-hairline-dark' : 'bg-white border-b border-hairline-light shadow-halos' %> py-2 lg:py-0 px-4 sm:px-8 relative z-30">
    <div class="max-w-7xl mx-auto flex items-center justify-between min-h-[65px] lg:min-h-[75px]">
      
      <!-- Brand Logo & Mobile Toggle -->
      <div class="flex items-center justify-between w-full lg:w-auto">
        <%= link_to root_path, class: 'flex items-center select-none py-1.5 transition-opacity hover:opacity-95 rounded px-2 lg:px-0' do %>
          <img src="/images/zevi_logo.png" alt="ZEVI Promotion Logo" class="h-8 sm:h-10 lg:h-11 object-contain" style="<%= marketing_page ? 'filter: invert(1) brightness(2)' : '' %>" />
        <% end %>

        <!-- Mobile Menu Toggle -->
        <button type="button" class="lg:hidden inline-flex items-center justify-center p-2 rounded-full border <%= marketing_page ? 'border-hairline-dark text-white hover:bg-white/10' : 'border-hairline-light text-black hover:bg-black/5' %> transition-colors" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/></svg>
        </button>
      </div>

      <!-- Navigation Tabs (Center) -->
      <nav class="hidden lg:flex items-stretch self-stretch">
        <ul class="flex items-stretch m-0 p-0 list-none">
          <li class="flex items-center">
            <%= link_to "Home", root_path, class: "#{marketing_page ? 'text-white border-b-2 border-white' : 'text-black border-b-2 border-black'} px-5 py-6 text-xs font-semibold tracking-wider uppercase transition-all flex items-center h-full" %>
          </li>
          <li class="flex items-center">
            <%= link_to "Shop Now", products_path, class: "#{marketing_page ? 'text-link-cool-2 hover:text-white' : 'text-shade-60 hover:text-black'} px-5 py-6 text-xs font-semibold tracking-wider uppercase transition-colors flex items-center h-full" %>
          </li>
          <li class="flex items-center">
            <%= link_to "Contact Us", "/#contact", class: "#{marketing_page ? 'text-link-cool-2 hover:text-white' : 'text-shade-60 hover:text-black'} px-5 py-6 text-xs font-semibold tracking-wider uppercase transition-colors flex items-center h-full" %>
          </li>
        </ul>
      </nav>

      <!-- Autocomplete Search (Desktop Only) -->
      <div class="hidden lg:flex items-center">
        <%= content_tag :div,
          "data-controller": "search",
          "data-search-current-class": "text-primary",
          class: "relative" do %>
          <%= form_tag autocomplete_results_path, method: :get, class: "flex items-center w-full rounded-full border #{marketing_page ? 'border-hairline-dark bg-black focus-within:border-white' : 'border-hairline-light bg-white focus-within:border-black'} overflow-hidden transition-all px-1.5 py-1", id: "search-form",
              "data-turbo": true,
              "data-turbo-stream": true,
              "data-search-target": "form" do %>

            <%= search_field_tag :keywords, params[:keywords], 
              placeholder: "Search products...", 
              id: "header-search-input", 
              class: "#{marketing_page ? 'bg-black text-white placeholder-shade-60' : 'bg-white text-black placeholder-shade-40'} border-0 py-1.5 px-4 text-xs font-sans w-52 xl:w-72 focus:ring-0 focus:outline-none", 
              autocomplete: "off",
              "data-action": "input->search#fetchResults
                              keydown.down->search#nextResult
                              keydown.up->search#previousResult
                              keydown.enter->search#openResult:prevent:stop
                              keydown.esc->search#reset:prevent:stop
                              click@window->search#focusOut",
              "data-search-target": "keywords" %>

            <%= button_tag type: 'button', onclick: "if(document.getElementById('header-search-input').value.trim().length > 0) window.location.href='/products?keywords=' + encodeURIComponent(document.getElementById('header-search-input').value)", class: marketing_page ? 'button-outline-on-dark !py-2 !px-4 !text-xs' : 'button-primary-pill !py-2 !px-4 !text-xs', title: 'Search' do %>
              SEARCH
            <% end %>
          <% end %>
          <div id="autocomplete-results-header" class="absolute right-0 top-full mt-2 w-96 hidden z-50" data-search-target="results"></div>
        <% end %>
      </div>
    </div>
  </header>

  <!-- Mobile Navigation Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden w-full flex flex-col transition-all duration-300 relative z-30 <%= marketing_page ? 'bg-black border-b border-hairline-dark' : 'bg-white border-b border-hairline-light shadow-halos' %>">
    
    <!-- Dynamic Categories Header Accordion -->
    <div class="<%= marketing_page ? 'bg-[#0a0a0a] text-white border-b border-hairline-dark' : 'bg-[#d4f9e0] text-black border-b border-hairline-light' %> px-6 py-4 flex items-center justify-between cursor-pointer" onclick="document.getElementById('mobile-categories-list').classList.toggle('hidden')">
      <span class="text-xs font-bold uppercase tracking-wider">Categories</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
    </div>

    <!-- Category Links List -->
    <div id="mobile-categories-list" class="hidden flex-col py-2">
      <% cache [I18n.locale, categories, taxon] do %>
        <%= render(TaxonsTreeComponent.new(
          root_taxon: categories.root,
          current_taxon: taxon,
          max_level: 1,
          item_classes: "block text-xs font-semibold uppercase tracking-wider px-10 py-3 transition-colors #{marketing_page ? 'text-link-cool-2 hover:bg-white/5 hover:text-white' : 'text-shade-60 hover:bg-black/5 hover:text-black'}",
          current_item_classes: marketing_page ? 'text-white' : 'text-black',
        )) if categories %>
      <% end %>
    </div>

    <!-- Links -->
    <div class="flex flex-col py-2">
      <%= link_to "Home", root_path, class: "text-xs font-bold uppercase tracking-wider px-6 py-4.5 transition-colors #{marketing_page ? 'text-white hover:bg-white/5' : 'text-black hover:bg-black/5'}" %>
      <%= link_to "Shop Now", products_path, class: "text-xs font-bold uppercase tracking-wider px-6 py-4.5 transition-colors #{marketing_page ? 'text-link-cool-2 hover:bg-white/5 hover:text-white' : 'text-shade-60 hover:bg-black/5 hover:text-black'}" %>
      <%= link_to "Contact Us", "/#contact", class: "text-xs font-bold uppercase tracking-wider px-6 py-4.5 transition-colors #{marketing_page ? 'text-link-cool-2 hover:bg-white/5 hover:text-white' : 'text-shade-60 hover:bg-black/5 hover:text-black'}" %>
    </div>

    <!-- Dropdown Search Bar -->
    <div class="px-6 py-6 border-t <%= marketing_page ? 'border-hairline-dark' : 'border-hairline-light' %>">
      <form action="<%= products_path %>" method="get" class="flex items-center rounded-full border <%= marketing_page ? 'border-hairline-dark bg-black' : 'border-hairline-light bg-white' %> overflow-hidden px-1.5 py-1">
        <input type="text" name="keywords" placeholder="Search products..." class="<%= marketing_page ? 'bg-black text-white placeholder-shade-60' : 'bg-white text-black placeholder-shade-40' %> w-full border-0 py-1.5 px-4 text-xs font-sans focus:ring-0 focus:outline-none">
        <button type="submit" class="<%= marketing_page ? 'button-outline-on-dark !py-2 !px-4 !text-xs' : 'button-primary-pill !py-2 !px-4 !text-xs' %>">SEARCH</button>
      </form>
    </div>
  </div>
</div>

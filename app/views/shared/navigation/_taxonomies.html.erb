<% max_level = Spree::Config[:max_level_in_taxons_menu] || 1 %>

<nav class="taxonomies flex flex-col">
  <% cache [I18n.locale, taxonomies, taxon, max_level] do %>
    <% taxonomies.each do |taxonomy| %>
      <% cache [I18n.locale, taxonomy, taxon, max_level] do %>
        <%= render(TaxonsTreeComponent.new(
          title: taxonomy.name,
          root_taxon: taxonomy.root,
          current_taxon: taxon,
          max_level: max_level,
          item_classes: 'text-body-md text-shade-60 hover:text-black hover:underline underline-offset-8 w-fit flex mb-2.5',
          current_item_classes: 'text-black font-semibold underline',
          title_classes: 'text-heading-sm text-black font-semibold mb-4 mt-8'
          )) %>
      <% end %>
    <% end %>
  <% end %>
</nav>

<%= element_view_for(carousel_slide, class: "carousel-slide #{'active' if local_assigns[:active]}") do |el| %>
  <%= el.render :image, { size: "1200x600" }, { class: "slide-bg" } %>
  
  <div class="carousel-overlay">
    <div class="carousel-content">
      <h3><%= el.render :subtitle %></h3>
      <h1><%= el.render :title %></h1>
      <p><%= el.render :description %></p>
      <a href="<%= carousel_slide.value_for('link') || '#' %>" class="btn-primary">
        <span>Shop Now</span>
        <span class="material-symbols-outlined">arrow_forward</span>
      </a>
    </div>
  </div>
<% end %>

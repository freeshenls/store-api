<% promotions = product.possible_promotions %>

<% if promotions.any? %>
  <section class="product-promotions flex flex-col gap-4 border border-hairline-light rounded-xl p-5 bg-[#d4f9e0]/20">
    <h2 class="text-heading-sm uppercase tracking-wider text-black m-0 font-medium"><%= t('spree.promotions') %></h2>

    <% promotions.each do |promotion| %>
      <article class="flex flex-col gap-1 border-t border-hairline-light/50 pt-3 first:border-0 first:pt-0">
        <header>
          <h3 class="text-body-strong text-black m-0"><%= promotion.name %></h3>
        </header>

        <p class="text-caption text-shade-60 leading-relaxed m-0"><%= promotion.description %></p>

        <% if promotion.products.any? %>
          <ul class="list-disc pl-5 mt-1">
            <% promotion.products.each do |prod| %>
              <li class="text-caption text-shade-60">
                <%= link_to prod.name, product_path(prod), class: "text-black underline font-medium hover:text-shade-60 transition-colors" %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </article>
    <% end %>
  </section>
<% end %>

<!-- Hero Layout Section -->
<section class="py-10">
  <div class="<%= container_custom %> grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-[30px]">
    <!-- Left Sidebar Categories -->
    <aside class="hidden lg:block <%= panel_card %> self-start">
      <div class="flex justify-between items-center w-full pb-3 border-b border-[#e2e8f0] mb-3">
        <div class="flex items-center gap-2">
          <%= heroicon "squares-2x2", options: { class: "size-5 text-[#074277]" } %>
          <span class="font-['Outfit'] text-[18px] font-extrabold text-[#0f172a]">Categories</span>
        </div>
      </div>
      <ul class="list-none p-0 m-0 flex flex-col gap-1">
        <% @categories.each do |cat| %>
          <% is_active = params[:category].to_s.downcase == cat.downcase %>
          <li class="group <%= 'active' if is_active %>">
            <a class="flex items-center justify-between py-2.5 px-3.5 text-sm font-medium rounded-[6px] transition-all duration-300 no-underline <%= is_active ? 'bg-[#074277] text-[#f8fafc]' : 'text-[#0f172a] hover:bg-[#074277]/[0.08] hover:text-[#074277]' %>" href="/products?category=<%= u(cat) %>">
              <span><%= cat %></span>
              <%= heroicon "chevron-right", options: { class: "size-4" } %>
            </a>
          </li>
        <% end %>
      </ul>
    </aside>

    <!-- Right Hero Carousel -->
    <div class="bg-[#121824] rounded-[20px] overflow-hidden shadow-lg relative aspect-[16/9] max-h-[400px] lg:max-h-[520px]" data-controller="carousel" data-action="touchstart->carousel#touchStart touchmove->carousel#touchMove touchend->carousel#touchEnd">
      <div class="w-full h-full flex transition-transform duration-600 ease-[cubic-bezier(0.25,1,0.5,1)]" data-carousel-target="track">
        <!-- Slide 1: Apparel -->
        <div class="carousel-slide relative shrink-0 w-full min-w-full max-w-full h-full flex items-center active" id="slide-1">
          <img class="w-full h-full object-cover absolute inset-0 z-0" src="<%= image_path('slide_apparel.jpg') %>" alt="Shop Apparel">
          <div class="absolute inset-0 bg-gradient-to-r from-[#0b0f19]/90 via-[#0b0f19]/40 to-transparent z-2 flex items-center p-[30px] lg:p-[60px]">
            <div class="max-w-[520px] text-[#f8fafc]">
              <h3 class="font-['Outfit'] text-xs sm:text-[13px] md:text-[15px] font-semibold text-[#b93530] uppercase tracking-wide md:tracking-[2px] mb-1 md:mb-2.5">Polos, Workwear, T-Shirts, & More!</h3>
              <h1 class="font-['Outfit'] text-lg sm:text-2xl md:text-[32px] font-extrabold leading-[1.15] mb-4 text-[#f8fafc]">Shop Apparel</h1>
              <p class="text-slate-300 text-xs sm:text-[13px] md:text-sm mb-3.5 md:mb-4 leading-snug md:leading-normal">Premium embroidered apparel and printed sportswear designed to make your brand stand out in any team event or corporate setting.</p>
              <a href="/products?category=Apparel" class="<%= btn_primary %> gap-2 text-xs sm:text-[13px] md:text-[15px] py-1.5 px-3.5 md:py-3 md:px-7 no-underline">
                <span>Shop Now</span>
                <%= heroicon "arrow-right" %>
              </a>
            </div>
          </div>
        </div>

        <!-- Slide 2: Spirit / Wristbands -->
        <div class="carousel-slide relative shrink-0 w-full min-w-full max-w-full h-full flex items-center" id="slide-2">
          <img class="w-full h-full object-cover absolute inset-0 z-0" src="<%= image_path('slide_spirit.png') %>" alt="Shop Spirit">
          <div class="absolute inset-0 bg-gradient-to-r from-[#0b0f19]/90 via-[#0b0f19]/40 to-transparent z-2 flex items-center p-[30px] lg:p-[60px]">
            <div class="max-w-[520px] text-[#f8fafc]">
              <h3 class="font-['Outfit'] text-xs sm:text-[13px] md:text-[15px] font-semibold text-[#b93530] uppercase tracking-wide md:tracking-[2px] mb-1 md:mb-2.5">Go Team!</h3>
              <h1 class="font-['Outfit'] text-lg sm:text-2xl md:text-[32px] font-extrabold leading-[1.15] mb-4 text-[#f8fafc]">Shop Spirit</h1>
              <p class="text-slate-300 text-xs sm:text-[13px] md:text-sm mb-3.5 md:mb-4 leading-snug md:leading-normal">Support your team, event, or school with custom caps, wristbands, notebooks, custom-printed bags, and custom swag kits.</p>
              <a href="/products?category=Wristbands" class="<%= btn_primary %> gap-2 text-xs sm:text-[13px] md:text-[15px] py-1.5 px-3.5 md:py-3 md:px-7 no-underline">
                <span>Shop Now</span>
                <%= heroicon "arrow-right" %>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation Arrows -->
      <button class="absolute top-1/2 -translate-y-1/2 left-5 w-11 h-11 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-[#f8fafc] hidden md:flex items-center justify-center text-2xl cursor-pointer z-5 transition-all duration-300 hover:bg-[#074277] hover:border-[#074277]" id="prev-btn" data-action="click->carousel#prev">
        <%= heroicon "chevron-left" %>
      </button>
      <button class="absolute top-1/2 -translate-y-1/2 right-5 w-11 h-11 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-[#f8fafc] hidden md:flex items-center justify-center text-2xl cursor-pointer z-5 transition-all duration-300 hover:bg-[#074277] hover:border-[#074277]" id="next-btn" data-action="click->carousel#next">
        <%= heroicon "chevron-right" %>
      </button>

      <!-- Carousel Dots -->
      <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-5">
        <div class="w-1.5 h-1.5 rounded-full bg-white/40 cursor-pointer transition-all duration-300 [&.active]:bg-[#074277] [&.active]:scale-120 active" data-carousel-target="dot" data-action="click->carousel#goToDot" data-slide="1"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-white/40 cursor-pointer transition-all duration-300 [&.active]:bg-[#074277] [&.active]:scale-120" data-carousel-target="dot" data-action="click->carousel#goToDot" data-slide="2"></div>
      </div>
    </div>
  </div>
</section>


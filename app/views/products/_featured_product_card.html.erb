<div class="relative bg-[#0a0a0a] overflow-hidden rounded-xl border border-hairline-dark/60 shadow-sheen-dark group hover:border-hairline-dark transition-all duration-300">
  <% image = product.gallery.images.second || product.gallery.images.first %>
  <%= render(ImageComponent.new(
    image: image,
    size: size,
    classes: 'w-full object-cover transition-transform duration-700 group-hover:scale-105'
  )) %>
  <div class="absolute flex flex-col gap-y-2 lg:gap-y-4 inset-x-6 bottom-6 lg:inset-x-8 lg:bottom-8 z-10">
    <span class="text-white drop-shadow-sm text-heading-xl font-light tracking-wide uppercase"><%= product.name %></span>
    <%= render partial: "shared/call_to_action", :locals => { :label => "Shop now", :url => product, :type => 'outline-on-dark' } %>
  </div>
</div>

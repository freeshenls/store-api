<%= element_view_for(header_contact, class: "contact-info") do |el| %>
  <a href="tel:<%= header_contact.value_for('phone').to_s.gsub(/[^0-9]/, '') %>" class="contact-item">
    <span class="icon material-symbols-outlined">call</span>
    <span><%= el.render :phone %></span>
  </a>
  <a href="mailto:<%= header_contact.value_for('email') %>" class="contact-item">
    <span class="icon material-symbols-outlined">mail</span>
    <span><%= el.render :email %></span>
  </a>
<% end %>

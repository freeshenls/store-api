<div class="col-span-full min-h-[50vh]">
  <h1 class="text-display-md text-black mb-5 leading-tight">
    <%= t('spree.your_cart_is_empty') %>
  </h1>

  <p class="text-body-md text-shade-50 mb-9 md:mb-14">
    You have no items in your shopping cart.

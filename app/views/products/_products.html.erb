<%
  paginated_products = @searcher.retrieve_products if params.key?(:keywords)
  paginated_products ||= products
%>

<% content_for :head do %>
  <% if paginated_products.respond_to?(:total_pages) %>
    <%= rel_next_prev_link_tags paginated_products %>
  <% end %>
<% end %>

<% if products.empty? %>
  <h1 class="text-display-md text-black mb-8 leading-tight">
    <%= t('spree.no_products_found') %>
  </h1>
<% else %>
  <% if params.key?(:keywords) %>
    <h1 class="text-display-md text-black mb-8 leading-tight">
      <%= t('spree.search_results', keywords: h(params[:keywords])) %>
    </h1>
  <% elsif local_assigns[:show_title] || taxon.nil? %>
    <h1 class="text-display-md text-black mb-8 leading-tight">All Products</h1>
  <% end %>

  <%= render 'products/products_grid', products: products, taxon: taxon %>
<% end %>

<% if paginated_products.respond_to?(:total_pages) %>
  <%= paginate paginated_products %>
<% end %>

<%
  phone_number = "(714) 857-0010"
  email_address = "info@zevipromotions.com"
%>

<!-- Top Utility Contact Bar -->
<div class="top-contact-bar">
  <div class="container-custom">
    <div class="contact-info">
      <a href="tel:<%= phone_number %>" class="contact-item">
        <span class="icon material-symbols-outlined">call</span>
        <span><%= phone_number %></span>
      </a>
      <a href="mailto:<%= email_address %>" class="contact-item">
        <span class="icon material-symbols-outlined">mail</span>
        <span><%= email_address %></span>
      </a>
    </div>
  </div>
</div>

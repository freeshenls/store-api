<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%== meta_data_tags %>
    <%= simple_canonical_tag %>
    <%= csrf_meta_tags %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag 'solidus_starter_frontend' %>
    <%= stylesheet_link_tag 'solidus_starter_frontend', media: 'screen' %>

    <%= javascript_importmap_tags %>

    <%= favicon_link_tag '/favicon.png', type: 'image/png', rel: 'icon' %>
    <%= favicon_link_tag '/favicon.ico', type: 'image/x-icon', rel: 'shortcut icon' %>
    <%= favicon_link_tag '/favicon.png', type: 'image/png', rel: 'apple-touch-icon' %>

    <script>
      const lsTheme = localStorage.getItem('theme') || 'light'
      document.documentElement.classList.add(lsTheme)
    </script>

    <%= yield :head %>
  </head>

  <% marketing_page = (controller_name == 'home' && action_name.in?(['index', 'about', 'contact'])) %>
  <body class="<%= body_class %> <%= marketing_page ? 'bg-[#000000] text-white font-sans' : 'bg-[#fbfbf5] text-black font-sans' %>" id="<%= @body_id || 'default' %>" data-turbo="false"  data-controller="drawer">
    <div class="min-h-screen grid grid-rows-[auto_1fr_auto]">
      <%= render 'layouts/header', taxons: @taxons, taxon: @taxon, marketing_page: marketing_page %>
      <main>
        <% unless marketing_page %>
          <%= render BreadcrumbsComponent.new(
            taxon: @product&.primary_taxon || @taxon,
            item_classes: 'text-body-xs text-shade-50',
            separator_classes: 'text-body-xs text-shade-50 ml-2',
            container_classes: 'flex gap-2',
            wrapper_classes: 'wrapper mt-4',
            order: @order
          ) %>
        <% end %>
        <% if flash_messages.present? %>
          <%= flash_messages %>
        <% end %>
        <%= yield %>
      </main>
      <%= render 'layouts/footer', marketing_page: marketing_page %>
      <div id="overlay" class="z-30 fixed top-0 left-0 w-full h-full bg-black opacity-50 hidden" data-action="click->drawer#toggle"></div>
      <!-- Floating Email Button -->
      <div class="fixed bottom-6 right-6 z-[60] flex flex-col items-end">
        <div id="floating-email-box" class="hidden bg-white border border-gray-200 shadow-xl rounded-lg p-4 mb-2 transition-opacity">
          <p class="text-xs text-gray-500 mb-1">Contact us at:</p>
          <a href="mailto:sales@digitalmonkey.com" class="text-sm font-bold text-[#0B457F] hover:underline">sales@digitalmonkey.com</a>
        </div>
        <button onclick="document.getElementById('floating-email-box').classList.toggle('hidden')" class="bg-white border border-gray-200 shadow-lg rounded px-3 py-2 flex flex-col items-center justify-center hover:bg-gray-50 transition-colors">
          <svg class="w-6 h-6 text-[#0B457F]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span class="text-xs font-semibold mt-0.5 text-[#0B457F]">Email</span>
        </button>
      </div>
    </div>
  </body>
</html>

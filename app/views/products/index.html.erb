                  </div>
                  <span class="product-qty">Min: 50 pcs</span>
                </div>
              </div>
            </div>
            <!-- 6 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #f1f5f9;">
                  <span class="material-symbols-outlined" style="font-size: 48px; color: #94a3b8;">checkroom</span>
                </div>
              </div>
              <div class="product-info">
                <span class="product-cat">Apparel</span>
                <h3 class="product-title">Unisex Midweight Cozy Fleece Pull-Over Custom Hoodie</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$34.99</span>
                  </div>
                  <span class="product-qty">Min: 12 pcs</span>
                </div>
              </div>
            </div>
            <!-- 7 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #f1f5f9;">
                  <span class="material-symbols-outlined" style="font-size: 48px; color: #94a3b8;">toys</span>

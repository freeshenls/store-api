<%
  type = local_assigns[:type].presence || 'primary'
  on_dark = local_assigns[:on_dark] || false
  
  # Select appropriate design system button class
  cta_class = case type
              when 'primary'
                'button-primary-pill inline-block'
              when 'secondary'
                on_dark ? 'button-outline-on-dark inline-block' : 'button-outline-on-light inline-block'
              when 'tertiary'
                'button-aloe-pill inline-block'
              when 'outline_dark'
                'button-outline-on-dark inline-block'
              when 'outline_light'
                'button-outline-on-light inline-block'
              else
                'button-primary-pill inline-block'
              end
              
  extra_classes = local_assigns[:additional_classes].presence || ''
  final_class = "#{cta_class} #{extra_classes}".strip
%>

<% if local_assigns[:url].present? %>
  <%= link_to label.html_safe, url, class: final_class, target: local_assigns[:target].presence || '_self' %> 
<% else %>
  <%= button_tag(label.html_safe, class: final_class, id: local_assigns[:id].presence || nil) %>
<% end %>

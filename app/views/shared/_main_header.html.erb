<%
  header_categories = [
    "Apparel",
    "Desk Accessories",
    "Drinkware",
    "Fidgets",
    "Novelties",
    "Gifts",
    "Bags & Totes",
    "Technology",
    "Wristbands"
  ]
%>

<!-- Main Header & Navbar -->
<header class="main-header">
  <div class="container-custom navbar-container">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo">
      <img src="<%= image_path('logo_zevi.png') %>" alt="Zevi Promotion Logo">
      <span>Zevi <span class="highlight">Promotion</span></span>
    </a>

    <!-- Search Form -->
    <form class="navbar-search" action="/products" method="GET">
      <span class="search-icon material-symbols-outlined">search</span>
      <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search products...">
      <button type="submit" class="search-submit">Search</button>
    </form>

    <!-- Desktop Navigation Menu -->
    <nav class="navbar-menu">
      <div class="navbar-link dropdown-trigger">
        <span>Categories</span>
        <span class="material-symbols-outlined" style="font-size: 16px;">keyboard_arrow_down</span>
        <div class="dropdown-menu-list">
          <% header_categories.each do |cat| %>
            <a href="/products?category=<%= u(cat) %>" class="dropdown-item"><%= cat %></a>
          <% end %>
        </div>
      </div>
      <a href="/" class="navbar-link <%= 'active' if current_page?('/') rescue false %>">Home</a>
      <a href="/products" class="navbar-link <%= 'active' if current_page?('/products') rescue false %>">Shop Now</a>
      <a href="/#about" class="navbar-link">About</a>
      <a href="#footer" class="navbar-link">Contact</a>
    </nav>

    <!-- Mobile menu toggle -->
    <button class="mobile-menu-toggle" id="mobile-menu-btn">
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>

  <!-- Mobile Navigation Accordion Menu -->
  <div id="mobile-dropdown-menu" class="mobile-accordion-menu">
    <div class="mobile-menu-links">
      <a href="/" class="mobile-menu-link <%= 'active' if current_page?('/') rescue false %>">Home</a>
      <a href="/products" class="mobile-menu-link <%= 'active' if current_page?('/products') rescue false %>">Product Catalog</a>
      <a href="/#about" class="mobile-menu-link">About</a>
      <a href="#footer" class="mobile-menu-link">Contact</a>
    </div>
  </div>
</header>

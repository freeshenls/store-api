<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: #0f172a; font-family: var(--font-body); padding: 20px; box-sizing: border-box;">
  
  <div style="background: rgba(30, 41, 59, 0.7); border: 1px solid #334155; backdrop-filter: blur(10px); border-radius: var(--radius-lg); padding: 48px 40px; width: 100%; max-width: 440px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2); box-sizing: border-box;">
    
    <!-- Zevi Admin Logo -->
    <div style="text-align: center; margin-bottom: 32px;">
      <span class="material-symbols-outlined" style="font-size: 56px; color: var(--highlight-red); display: block; margin: 0 auto 12px auto;">admin_panel_settings</span>
      <h1 style="font-family: var(--font-display); font-weight: 800; font-size: 26px; color: #ffffff; margin: 0;">Zevi Admin Portal</h1>
      <p style="font-size: 13px; color: #94a3b8; margin: 6px 0 0 0;">Please sign in to access the uploader dashboard</p>
    </div>

    <!-- Alert and Notice handlers -->
    <% if alert = flash[:alert] %>
      <div style="padding: 12px 16px; background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: var(--radius-sm); color: #fca5a5; font-size: 13px; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined" style="font-size: 16px;">error</span>
        <span><%= alert %></span>
      </div>
    <% end %>

    <% if notice = flash[:notice] %>
      <div style="padding: 12px 16px; background-color: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.3); border-radius: var(--radius-sm); color: #86efac; font-size: 13px; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span>
        <span><%= notice %></span>
      </div>
    <% end %>

    <%= form_with url: session_url, local: true do |form| %>
      
      <!-- Email field -->
      <div style="margin-bottom: 20px;">
        <label for="email_address" style="display: block; font-size: 12px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">Email Address</label>
        <%= form.email_field :email_address, id: "email_address", required: true, autofocus: true, autocomplete: "username", placeholder: "admin@zevipromotions.com", value: params[:email_address], style: "width: 100%; box-sizing: border-box; background: rgba(15, 23, 42, 0.6); border: 1px solid #334155; border-radius: var(--radius-sm); padding: 12px 16px; font-size: 14px; color: #ffffff; outline: none; transition: var(--transition);", onfocus: "this.style.borderColor='var(--primary)'", onblur: "this.style.borderColor='#334155'" %>
      </div>

      <!-- Password field -->
      <div style="margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label for="password" style="display: block; font-size: 12px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin: 0;">Password</label>
          <%= link_to "Forgot?", new_password_path, style: "font-size: 12px; color: var(--primary); text-decoration: none;" %>
        </div>
        <%= form.password_field :password, id: "password", required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72, style: "width: 100%; box-sizing: border-box; background: rgba(15, 23, 42, 0.6); border: 1px solid #334155; border-radius: var(--radius-sm); padding: 12px 16px; font-size: 14px; color: #ffffff; outline: none; transition: var(--transition);", onfocus: "this.style.borderColor='var(--primary)'", onblur: "this.style.borderColor='#334155'" %>
      </div>

      <!-- Submit button -->
      <div style="margin-top: 32px;">
        <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; padding: 14px 20px; font-size: 15px; font-weight: 700; border: none; cursor: pointer;">
          <span class="material-symbols-outlined" style="font-size: 18px;">login</span>
          <span>Sign In to Dashboard</span>
        </button>
      </div>

    <% end %>

    <!-- Back to storefront link -->
    <div style="text-align: center; margin-top: 24px; border-top: 1px solid #334155; padding-top: 16px;">
      <a href="/" style="font-size: 13px; color: #94a3b8; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
        <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
        <span>Back to Storefront</span>
      </a>
    </div>

  </div>

</div>

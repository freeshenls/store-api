<%
  product_link = "/products/#{product.slug}"
  image = product.images.first
%>
<div class="product-card">
  <div class="product-image-wrapper">
    <a href="<%= product_link %>" class="product-image-link" style="display: block; width: 100%; height: 100%;">
      <% if image %>
        <img src="<%= url_for(image) %>" alt="<%= product.title %>">
      <% else %>
        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #f3f4f6; color: #9ca3af; font-weight: 500;">No Image</div>
      <% end %>
    </a>

    <% if product.badge.present? %>
      <span class="product-badge"><%= product.badge %></span>
    <% end %>
  </div>
  
  <div class="product-info" style="padding: 10px 12px; display: flex; flex-direction: column; flex: 1;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
      <% unless local_assigns[:hide_category] %>
        <span class="product-cat" style="margin: 0; font-size: 10px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;"><%= product.category %></span>
      <% else %>
        <span></span>
      <% end %>
    </div>
    
    <h3 class="product-title" style="margin: 2px 0 4px 0; font-size: 13px; font-weight: 600; line-height: 1.35; height: 35px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-family: var(--font-display);">
      <a href="<%= product_link %>" style="color: var(--primary); text-decoration: none; transition: color 0.2s ease;" onmouseover="this.style.color='var(--primary-hover)'" onmouseout="this.style.color='var(--primary)'" title="<%= product.title %>">
        <%= product.title %>
      </a>
    </h3>
    
    <div class="product-meta-details" style="font-size: 12px; color: var(--text-muted); line-height: 1.4; font-family: var(--font-body); margin-top: auto; padding-top: 4px;">
      <div style="color: var(--text-dark); font-weight: 500;">
        <%= product.min_qty %> @ <%= product.price %>
      </div>
    </div>
  </div>
</div>

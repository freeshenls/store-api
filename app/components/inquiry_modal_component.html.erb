<div class="shadow-md bg-white border border-[#e2e8f0] rounded-[20px] overflow-hidden self-start">
  <div class="py-3 px-4 bg-[#074277] text-[#f8fafc] font-['Outfit'] font-extrabold text-[15px] uppercase tracking-wider">
    Request a Quote
  </div>
  
  <div class="flex bg-[#f8fafc] border-b border-[#e2e8f0] py-2 px-4 gap-3 items-center overflow-x-auto whitespace-nowrap">
    <span class="group step-nav-item active flex items-center gap-2 text-[13px] font-semibold text-[#64748b] cursor-pointer [&.active]:text-[#074277] [&.completed]:text-[#074277]" data-step="1" data-inquiry-target="navItem" data-action="click->inquiry#goToStep">
      <span class="w-[22px] h-[22px] rounded-full bg-[#cbd5e1] text-white flex items-center justify-center text-[11px] font-bold group-[.active]:bg-[#074277] group-[.completed]:bg-[#074277]">1</span>Contact
    </span>
    <span class="text-[#64748b] text-[13px]">&gt;</span>
    <span class="group step-nav-item flex items-center gap-2 text-[13px] font-semibold text-[#64748b] cursor-pointer [&.active]:text-[#074277] [&.completed]:text-[#074277]" data-step="2" data-inquiry-target="navItem" data-action="click->inquiry#goToStep">
      <span class="w-[22px] h-[22px] rounded-full bg-[#cbd5e1] text-white flex items-center justify-center text-[11px] font-bold group-[.active]:bg-[#074277] group-[.completed]:bg-[#074277]">2</span>Details & Artwork
    </span>
  </div>

  <form id="inline-quote-form" data-inquiry-target="form" data-action="submit->inquiry#submitForm" class="p-4 flex flex-col gap-2.5 box-border">
    <input type="hidden" name="product_id" value="<%= @product.id %>">
    
    <div class="stepper-step hidden [&.active]:flex [&.active]:flex-col [&.active]:gap-2.5 active" data-step="1" data-inquiry-target="step">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-start mb-2.5">
        <div class="w-full sm:w-[30%] sm:max-w-[30%] pr-0 sm:pr-2 pt-0 sm:pt-1.5 text-left sm:text-right mb-1 sm:mb-0 box-border">
          <label class="font-['Inter'] text-[13px] font-bold text-[#0f172a]">First name <span class="text-[#b93530]">*</span></label>
        </div>
        <div class="w-full sm:w-[70%] sm:max-w-[70%] box-border">
          <input type="text" required class="w-full h-8 border border-[#e2e8f0] rounded-[6px] px-2.5 font-['Inter'] text-[13.5px] text-[#0f172a] outline-none bg-white transition-all duration-300 box-border focus:border-[#074277] focus:shadow-[0_0_0_3px_rgba(7,66,119,0.08)]" name="first_name" data-inquiry-target="firstName">
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-start mb-2.5">
        <div class="w-full sm:w-[30%] sm:max-w-[30%] pr-0 sm:pr-2 pt-0 sm:pt-1.5 text-left sm:text-right mb-1 sm:mb-0 box-border">
          <label class="font-['Inter'] text-[13px] font-bold text-[#0f172a]">Last name <span class="text-[#b93530]">*</span></label>
        </div>
        <div class="w-full sm:w-[70%] sm:max-w-[70%] box-border">
          <input type="text" required class="w-full h-8 border border-[#e2e8f0] rounded-[6px] px-2.5 font-['Inter'] text-[13.5px] text-[#0f172a] outline-none bg-white transition-all duration-300 box-border focus:border-[#074277] focus:shadow-[0_0_0_3px_rgba(7,66,119,0.08)]" name="last_name" data-inquiry-target="lastName">
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-start mb-2.5">
        <div class="w-full sm:w-[30%] sm:max-w-[30%] pr-0 sm:pr-2 pt-0 sm:pt-1.5 text-left sm:text-right mb-1 sm:mb-0 box-border">
          <label class="font-['Inter'] text-[13px] font-bold text-[#0f172a]">Company name <span class="text-[#b93530]">*</span></label>
        </div>
        <div class="w-full sm:w-[70%] sm:max-w-[70%] box-border">
          <input type="text" required class="w-full h-8 border border-[#e2e8f0] rounded-[6px] px-2.5 font-['Inter'] text-[13.5px] text-[#0f172a] outline-none bg-white transition-all duration-300 box-border focus:border-[#074277] focus:shadow-[0_0_0_3px_rgba(7,66,119,0.08)]" name="company_name" data-inquiry-target="companyName">
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-start mb-2.5">
        <div class="w-full sm:w-[30%] sm:max-w-[30%] pr-0 sm:pr-2 pt-0 sm:pt-1.5 text-left sm:text-right mb-1 sm:mb-0 box-border">
          <label class="font-['Inter'] text-[13px] font-bold text-[#0f172a]">Email <span class="text-[#b93530]">*</span></label>
        </div>
        <div class="w-full sm:w-[70%] sm:max-w-[70%] box-border">
          <input type="email" required class="w-full h-8 border border-[#e2e8f0] rounded-[6px] px-2.5 font-['Inter'] text-[13.5px] text-[#0f172a] outline-none bg-white transition-all duration-300 box-border focus:border-[#074277] focus:shadow-[0_0_0_3px_rgba(7,66,119,0.08)]" name="email" data-inquiry-target="email">
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-start mb-2.5">
        <div class="w-full sm:w-[30%] sm:max-w-[30%] pr-0 sm:pr-2 pt-0 sm:pt-1.5 text-left sm:text-right mb-1 sm:mb-0 box-border">
          <label class="font-['Inter'] text-[13px] font-bold text-[#0f172a]">Phone number</label>
        </div>
        <div class="w-full sm:w-[70%] sm:max-w-[70%] flex gap-2 box-border">
          <select class="w-full h-8 border border-[#e2e8f0] rounded-[6px] font-['Inter'] text-[13.5px] text-[#0f172a] outline-none bg-white transition-all duration-300 box-border focus:border-[#074277] focus:shadow-[0_0_0_3px_rgba(7,66,119,0.08)] max-w-[110px] !p-0" name="phone_country" data-inquiry-target="phoneCountry" data-action="change->inquiry#updatePhonePrefix">
            <option value="United States">United States</option>
            <option value="Canada">Canada</option>
            <option value="United Kingdom">United Kingdom</option>
            <option value="Australia">Australia</option>
          </select>
          <div class="relative flex-grow flex box-border">
            <input type="text" id="phone-prefix" value="+1" readonly data-inquiry-target="phonePrefix" class="w-[42px] text-center border border-r-0 border-[#e2e8f0] rounded-l-[6px] rounded-r-none text-[13px] bg-[#f8fafc] text-[#64748b] outline-none h-8 box-border font-['Inter']">
            <input type="tel" class="w-full h-8 border border-[#e2e8f0] px-2.5 font-['Inter'] text-[13.5px] text-[#0f172a] outline-none bg-white transition-all duration-300 box-border focus:border-[#074277] focus:shadow-[0_0_0_3px_rgba(7,66,119,0.08)] !rounded-l-none flex-grow !h-8" name="phone" placeholder="Phone number" data-inquiry-target="phoneInput">
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-start mb-2.5">
        <div class="w-full sm:w-[30%] sm:max-w-[30%] pr-0 sm:pr-2 pt-0 sm:pt-1.5 text-left sm:text-right mb-1 sm:mb-0 box-border">
          <label class="font-['Inter'] text-[13px] font-bold text-[#0f172a]">Country/Region</label>
        </div>
        <div class="w-full sm:w-[70%] sm:max-w-[70%] box-border">
          <input type="text" class="w-full h-8 border border-[#e2e8f0] rounded-[6px] px-2.5 font-['Inter'] text-[13.5px] text-[#0f172a] outline-none bg-white transition-all duration-300 box-border focus:border-[#074277] focus:shadow-[0_0_0_3px_rgba(7,66,119,0.08)]" name="country" placeholder="Enter country/region...">
        </div>
      </div>

      <div class="mt-1 flex justify-between items-center border-t border-[#e2e8f0] pt-2 box-border">
        <div></div> 
        <button type="button" class="h-[30px] px-3 bg-[#074277] text-white border-none rounded-[6px] font-['Outfit'] font-bold text-xs cursor-pointer inline-flex items-center gap-1 box-border hover:bg-[#052e54]" data-action="click->inquiry#nextStep">
          <span>Next Step</span>
          <%= heroicon "arrow-right", options: { class: "size-4" } %>
        </button>
      </div>
    </div>

    <div class="stepper-step hidden [&.active]:flex [&.active]:flex-col [&.active]:gap-2.5" data-step="2" data-inquiry-target="step">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-start mb-2.5">
        <div class="w-full sm:w-[30%] sm:max-w-[30%] pr-0 sm:pr-2 pt-0 sm:pt-1.5 text-left sm:text-right mb-1 sm:mb-0 box-border">
          <label class="font-['Inter'] text-[13px] font-bold text-[#0f172a]">Your Artwork</label>
        </div>
        <div class="w-full sm:w-[70%] sm:max-w-[70%] box-border">
          <div class="flex flex-col gap-1 w-full box-border">
            <input type="file" name="artwork" accept="image/*,.pdf,.ai,.eps,.cdr" class="py-1 px-2.5 border border-dashed border-[#e2e8f0] rounded-[6px] text-[13px] bg-[#f8fafc] w-full cursor-pointer box-border h-8">
            <span class="text-[11px] text-[#64748b]">Supported: AI, CDR, EPS, PDF, PNG, JPG (Optional)</span>
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-start mb-2.5">
        <div class="w-full sm:w-[30%] sm:max-w-[30%] pr-0 sm:pr-2 pt-0 sm:pt-1.5 text-left sm:text-right mb-1 sm:mb-0 box-border">
          <label class="font-['Inter'] text-[13px] font-bold text-[#0f172a]">Color</label>
        </div>
        <div class="w-full sm:w-[70%] sm:max-w-[70%] box-border">
          <input type="text" class="w-full h-8 border border-[#e2e8f0] rounded-[6px] px-2.5 font-['Inter'] text-[13.5px] text-[#0f172a] outline-none bg-white transition-all duration-300 box-border focus:border-[#074277] focus:shadow-[0_0_0_3px_rgba(7,66,119,0.08)]" name="color" placeholder="Preferred color(s)">
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-start mb-2.5">
        <div class="w-full sm:w-[30%] sm:max-w-[30%] pr-0 sm:pr-2 pt-0 sm:pt-1.5 text-left sm:text-right mb-1 sm:mb-0 box-border">
          <label class="font-['Inter'] text-[13px] font-bold text-[#0f172a]">Quantity</label>
        </div>
        <div class="w-full sm:w-[70%] sm:max-w-[70%] box-border">
          <input type="number" class="w-full h-8 border border-[#e2e8f0] rounded-[6px] px-2.5 font-['Inter'] text-[13.5px] text-[#0f172a] outline-none bg-white transition-all duration-300 box-border focus:border-[#074277] focus:shadow-[0_0_0_3px_rgba(7,66,119,0.08)]" name="quantity" id="synced-qty-input" data-inquiry-target="quantityInput" min="1" data-action="input->inquiry#highlightPricingTier">
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-start mb-2.5">
        <div class="w-full sm:w-[30%] sm:max-w-[30%] pr-0 sm:pr-2 pt-0 sm:pt-1.5 text-left sm:text-right mb-1 sm:mb-0 box-border">
          <label class="font-['Inter'] text-[13px] font-bold text-[#0f172a]">Need-by Date</label>
        </div>
        <div class="relative flex-grow w-full sm:w-[70%] sm:max-w-[70%] flex items-center box-border">
          <input type="text" class="w-full h-8 border border-[#e2e8f0] rounded-[6px] px-2.5 font-['Inter'] text-[13.5px] text-[#0f172a] outline-none transition-all duration-300 focus:border-[#074277] focus:shadow-[0_0_0_3px_rgba(7,66,119,0.08)] flatpickr !pr-9 bg-white w-full box-border" name="date_required" data-controller="datepicker" placeholder="Select date..." readonly>
          <%= heroicon "calendar", options: { class: "absolute right-2.5 text-[#64748b] pointer-events-none size-5" } %>
        </div>
      </div>



      <div class="flex flex-col sm:flex-row items-stretch sm:items-start mb-2.5">
        <div class="w-full sm:w-[30%] sm:max-w-[30%] pr-0 sm:pr-2 pt-0 sm:pt-1.5 text-left sm:text-right mb-1 sm:mb-0 box-border">
          <label class="font-['Inter'] text-[13px] font-bold text-[#0f172a]">Comments</label>
        </div>
        <div class="w-full sm:w-[70%] sm:max-w-[70%] box-border">
          <textarea class="w-full border border-[#e2e8f0] rounded-[6px] px-2.5 font-['Inter'] text-[13.5px] text-[#0f172a] outline-none bg-white transition-all duration-300 box-border focus:border-[#074277] focus:shadow-[0_0_0_3px_rgba(7,66,119,0.08)] h-auto py-1.5" rows="3" name="comments" placeholder="Any special requests or comments..."></textarea>
        </div>
      </div>

      <div class="mt-1 flex justify-between items-center border-t border-[#e2e8f0] pt-2 box-border">
        <button type="button" class="h-[30px] px-2.5 bg-transparent text-[#64748b] border border-[#e2e8f0] rounded-[6px] font-['Outfit'] font-bold text-xs cursor-pointer inline-flex items-center gap-1 box-border hover:bg-[#f8fafc] hover:border-[#64748b]" data-action="click->inquiry#prevStep">
          <%= heroicon "arrow-left", options: { class: "size-4" } %>
          <span>Back</span>
        </button>
        <button type="submit" class="h-[30px] px-3 bg-[#074277] text-white border-none rounded-[6px] font-['Outfit'] font-bold text-xs cursor-pointer inline-flex items-center gap-1 box-border hover:bg-[#052e54]" data-inquiry-target="submitBtn">
          <span>Submit</span>
          <%= heroicon "paper-airplane", options: { class: "size-4" } %>
        </button>
      </div>
    </div>
  </form>
</div>

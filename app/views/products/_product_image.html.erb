<div class="col-span-full md:col-span-9">
  <picture class="flex justify-center items-center bg-white border border-hairline-light shadow-halos w-full h-full rounded-xl aspect-square p-6">
    <%= render(ImageComponent.new(
      image: product.gallery.images.first,
      size: :product,
      itemprop: "image",
      data: { js: 'product-main-image' },
      classes: 'object-contain max-h-full max-w-full'
    )) %>
  </picture>
</div>

<!-- 2. Trending Products Section -->
<section class="section-padding trending-products-section" id="products">
  <div class="container-custom">
    <div style="text-align: center; margin-bottom: 24px;">
      <h2 style="font-size: 26px; font-weight: 700; color: var(--text-dark); margin-bottom: 10px; font-family: var(--font-display);">Trending Products</h2>
      <hr class="bottomBorder" style="border: 0; height: 3px; background: var(--primary); width: 60px; margin: 0 auto;">
    </div>

    <div class="product-slider-wrapper">
      <!-- Left Navigation Arrow -->
      <button class="slider-nav-btn prev-btn" onclick="slideProducts('prev')" aria-label="Slide left">
        <span class="material-symbols-outlined">chevron_left</span>
      </button>
      
      <div class="product-slider-container">
        <div class="product-slider-track" id="productSliderTrack" style="transform: translateX(0px);">
          <% if @trending_products.any? %>
            <% @trending_products.each do |product| %>
              <div class="slider-item">
                <%= render "shared/product_card", product: product, hide_category: true %>
              </div>
            <% end %>
          <% else %>
            <div style="text-align: center; padding: 40px; color: var(--text-muted); font-size: 14px; width: 100%;">
              No products available at the moment.
            </div>
          <% end %>
        </div>
      </div>

      <!-- Right Navigation Arrow -->
      <button class="slider-nav-btn next-btn" onclick="slideProducts('next')" aria-label="Slide right">
        <span class="material-symbols-outlined">chevron_right</span>
      </button>
    </div>

    <!-- Product Slider Control Script -->
    <script>
      (function() {
        function initProductSlider() {
          const track = document.getElementById("productSliderTrack");
          if (!track) return;

          if (window.innerWidth <= 768) {
            track.style.transform = "none";
          } else {
            track.style.transform = "translateX(0px)";
          }
          track.dataset.currentIndex = "0";

          window.adjustProductSlidePosition = function() {
            const track = document.getElementById("productSliderTrack");
            if (!track) return;
            if (window.innerWidth <= 768) {
              track.style.transform = "none";
              return;
            }
            const items = track.querySelectorAll(".slider-item");
            if (items.length === 0) return;

            const gap = 24;
            const itemWidth = items[0].getBoundingClientRect().width + gap;
            const currentIndex = parseInt(track.dataset.currentIndex || "0");
            const offset = -currentIndex * itemWidth;
            track.style.transform = `translateX(${offset}px)`;
          };

          window.slideProducts = function(direction) {
            if (window.innerWidth <= 768) return; 
            const track = document.getElementById("productSliderTrack");
            if (!track) return;

            const items = track.querySelectorAll(".slider-item");
            if (items.length === 0) return;

            const gap = 24;
            const itemWidth = items[0].getBoundingClientRect().width + gap; 
            const containerWidth = track.parentElement.getBoundingClientRect().width;
            
            let currentIndex = parseInt(track.dataset.currentIndex || "0");
            const visibleCount = Math.round(containerWidth / itemWidth);
            const maxIndex = Math.max(0, items.length - visibleCount);

            if (direction === "next") {
              if (currentIndex < maxIndex) {
                currentIndex++;
              } else {
                currentIndex = 0; 
              }
            } else if (direction === "prev") {
              if (currentIndex > 0) {
                currentIndex--;
              } else {
                currentIndex = maxIndex; 
              }
            }

            track.dataset.currentIndex = currentIndex.toString();
            if (typeof window.adjustProductSlidePosition === "function") {
              window.adjustProductSlidePosition();
            }
          };

          const productWrapper = document.querySelector(".product-slider-wrapper");
          if (productWrapper && !productWrapper.dataset.swipeRegistered) {
            let startX = 0;
            let endX = 0;
            
            productWrapper.addEventListener("touchstart", function(e) {
              startX = e.touches[0].clientX;
              endX = e.touches[0].clientX;
            }, { passive: true });
            
            productWrapper.addEventListener("touchmove", function(e) {
              endX = e.touches[0].clientX;
            }, { passive: true });
            
            productWrapper.addEventListener("touchend", function() {
              if (window.innerWidth <= 768) return; 
              const threshold = 40;
              const diff = startX - endX;
              if (Math.abs(diff) > threshold) {
                if (diff > 0) {
                  if (typeof window.slideProducts === "function") {
                    window.slideProducts("next");
                  }
                } else {
                  if (typeof window.slideProducts === "function") {
                    window.slideProducts("prev");
                  }
                }
              }
              startX = 0;
              endX = 0;
            });
            
            productWrapper.dataset.swipeRegistered = "true";
          }
        }

        if (!window.productSliderResizeRegistered) {
          window.addEventListener("resize", function() {
            if (typeof window.adjustProductSlidePosition === "function") {
              window.adjustProductSlidePosition();
            }
          });
          window.productSliderResizeRegistered = true;
        }

        document.addEventListener("turbo:load", initProductSlider);
        
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initProductSlider);
        } else {
          initProductSlider();
        }
      })();
    </script>

    <div class="section-footer">
      <a href="/products" class="btn-secondary">
        <span>More Deals</span>
        <span class="material-symbols-outlined" style="font-size: 16px;">chevron_right</span>
      </a>
    </div>
  </div>
</section>


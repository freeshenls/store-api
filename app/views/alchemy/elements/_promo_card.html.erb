<%= element_view_for(promo_card, class: "promo-card") do |el| %>
  <%= el.render :image, { size: "400x300", class: "promo-bg" } %>
  
  <div class="promo-card-overlay"></div>
  <div class="promo-card-content">
    <h4><%= el.render :subtitle %></h4>
    <h2><%= el.render :title %></h2>
    <a href="<%= promo_card.value_for('link') || '#' %>" class="textBtn">
      <span>Shop Now</span>
      <span class="material-symbols-outlined" style="font-size: 14px;">arrow_forward</span>
    </a>
  </div>
<% end %>

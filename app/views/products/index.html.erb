<%
  # Set up category fallbacks in case the database is in an empty state
  categories = @categories.any? ? @categories : [
    "Apparel",
    "Desk Accessories",
    "Drinkware",
    "Fidgets",
    "Novelties",
    "Gifts",
    "Bags & Totes",
    "Technology"
  ]

  # Retrieve unified contact details from Alchemy Layout Pages (Global Pages)
  global_page = Alchemy::Page.layoutpages.find_by(page_layout: 'global_layout')


  header_contact = global_page&.elements&.find_by(name: 'header_contact')
  
  # Fallback to local page element if global is not yet created/published in the editor
  header_contact ||= @page.elements.find_by(name: 'header_contact') if @page
  
  phone_number = header_contact&.value_for('phone').presence || "(714) 857-0010"
  email_address = header_contact&.value_for('email').presence || "sales@zevipromotion.com"
%>

<!-- Top Utility Contact Bar -->
<div class="top-contact-bar">
  <div class="container-custom">
    <div class="contact-info">
      <a href="tel:<%= phone_number %>" class="contact-item">
        <span class="icon material-symbols-outlined">call</span>
        <span><%= phone_number %></span>
      </a>
      <a href="mailto:<%= email_address %>" class="contact-item">
        <span class="icon material-symbols-outlined">mail</span>
        <span><%= email_address %></span>
      </a>
    </div>
  </div>
</div>

<!-- Main Header & Navbar -->
<header class="main-header">
  <div class="container-custom navbar-container">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo">
      <img src="<%= image_path('logo_zevi.png') %>" alt="Zevi Promotion Logo">
      <span>Zevi <span class="highlight">Promotion</span></span>
    </a>

    <!-- Search Form -->
    <form class="navbar-search" action="/products" method="GET">
      <span class="search-icon material-symbols-outlined">search</span>
      <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search products...">
      <button type="submit" class="search-submit">Search</button>
    </form>

    <!-- Desktop Navigation Menu -->
    <nav class="navbar-menu">
      <div class="navbar-link dropdown-trigger">
        <span>Categories</span>
        <span class="material-symbols-outlined" style="font-size: 16px;">keyboard_arrow_down</span>
        <div class="dropdown-menu-list">
          <a href="/products" class="dropdown-item">All Products</a>
          <% categories.each do |cat| %>
            <a href="/products?category=<%= u(cat) %>" class="dropdown-item"><%= cat %></a>
          <% end %>
        </div>
      </div>
      <a href="/" class="navbar-link">Home</a>
      <a href="/products" class="navbar-link active">Shop Now</a>
      <a href="javascript:void(0)" class="navbar-link">About</a>
      <a href="#footer" class="navbar-link">Contact</a>
    </nav>

    <!-- Mobile menu toggle -->
    <button class="mobile-menu-toggle" id="mobile-menu-btn">
      <span class="material-symbols-outlined">menu</span>
    </button>
  </div>

  <!-- Mobile Navigation Accordion Menu -->
  <div id="mobile-dropdown-menu" class="mobile-accordion-menu">
    <div class="mobile-menu-links">
      <a href="/" class="mobile-menu-link">Home</a>
      <a href="/products" class="mobile-menu-link active">Product Catalog</a>
      <a href="javascript:void(0)" class="mobile-menu-link">About</a>
      <a href="#footer" class="mobile-menu-link">Contact</a>
    </div>
  </div>
</header>


<!-- Main Products Content Grid -->
<section class="hero-layout-section">
  <div class="container-custom hero-grid">
    <!-- Left Sidebar Category Filters -->
    <aside class="categories-sidebar">
      <div class="sidebar-title" id="filter-toggle-btn" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center; width: 100%;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="material-symbols-outlined" style="font-size: 20px; color: var(--primary);">grid_view</span>
          <span>Categories</span>
        </div>
        <span class="material-symbols-outlined filter-arrow-icon" style="font-size: 20px; transition: transform 0.3s;">keyboard_arrow_down</span>
      </div>
      <ul class="sidebar-menu-list">
        <li class="sidebar-menu-item <%= 'active' unless params[:category].present? %>">
          <a href="/products<%= "?q=#{params[:q]}" if params[:q].present? %>">
            <span>All Products</span>
            <span class="material-symbols-outlined" style="font-size: 16px;">chevron_right</span>
          </a>
        </li>
        <% categories.each do |cat| %>
          <% is_active = params[:category].to_s.downcase == cat.downcase %>
          <li class="sidebar-menu-item <%= 'active' if is_active %>">
            <a href="/products?category=<%= u(cat) %><%= "&q=#{params[:q]}" if params[:q].present? %>">
              <span><%= cat %></span>
              <span class="material-symbols-outlined" style="font-size: 16px;">chevron_right</span>
            </a>
          </li>
        <% end %>
      </ul>
    </aside>

    <!-- Right Products List Grid -->
    <div>
      <!-- Page Header & Search Feedback -->
      <div style="margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; border-bottom: 1px solid var(--light-border); padding-bottom: 16px;">
        <div>
          <h1 style="font-family: var(--font-display); font-size: 28px; font-weight: 800; color: var(--text-dark);">
            <%= @category_filter.present? ? @category_filter : "Product Catalog" %>
          </h1>
          <% if @query.present? %>
            <p style="font-size: 14px; color: var(--text-muted); margin-top: 4px;">
              Showing results for "<strong style="color: var(--text-dark);"><%= @query %></strong>"
            </p>
          <% end %>
        </div>
        <div style="display: flex; align-items: center; gap: 16px; font-size: 14px; color: var(--text-muted); font-weight: 500; flex-wrap: wrap;">
          <div>
            Found <strong style="color: var(--text-dark); font-family: var(--font-display);"><%= @all_product_cards.any? ? @total_products : (params[:q].blank? && params[:category].blank? ? 12 : 0) %></strong> products
          </div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <span>Show:</span>
            <%
              def page_size_url(size)
                "/products?per_page=#{size}" +
                (params[:category].present? ? "&category=#{u(params[:category])}" : "") +
                (params[:q].present? ? "&q=#{u(params[:q])}" : "")
              end
            %>
            <select onchange="window.location.href = this.value" style="padding: 6px 12px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); font-size: 13px; font-weight: 600; color: var(--text-dark); background: var(--light-surface); outline: none; cursor: pointer; transition: var(--transition);" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='var(--light-border)'">
              <option value="<%= page_size_url(15) %>" <%= 'selected' if @per_page == 15 %>>15 / Page</option>
              <option value="<%= page_size_url(30) %>" <%= 'selected' if @per_page == 30 %>>30 / Page</option>
              <option value="<%= page_size_url(60) %>" <%= 'selected' if @per_page == 60 %>>60 / Page</option>
              <option value="<%= page_size_url(120) %>" <%= 'selected' if @per_page == 120 %>>120 / Page</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Products Grid -->
      <% if @product_cards.any? %>
        <div class="product-grid">
          <% @product_cards.each do |product| %>
            <%= render "alchemy/elements/product_card", product_card: product %>
          <% end %>
        </div>
      <% else %>
        <% if params[:q].blank? && params[:category].blank? %>
          <!-- Gorgeous Fallback Mockups (No Products in DB State) -->
          <div class="product-grid">
            <!-- 1 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('card_drinkware.png') %>" alt="Tumbler">
                <span class="product-badge">New</span>
              </div>
              <div class="product-info">
                <span class="product-cat">Drinkware</span>
                <h3 class="product-title">Custom Double-Wall Stainless Steel Insulated Tumbler</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$12.99</span>
                  </div>
                  <span class="product-qty">Min: 50 pcs</span>
                </div>
              </div>
            </div>
            <!-- 2 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('slide_apparel.png') %>" alt="Polo Shirt">
                <span class="product-badge">Best Seller</span>
              </div>
              <div class="product-info">
                <span class="product-cat">Apparel</span>
                <h3 class="product-title">Embroidered Cotton Performance Pique Polo Shirt</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$24.99</span>
                  </div>
                  <span class="product-qty">Min: 12 pcs</span>
                </div>
              </div>
            </div>
            <!-- 3 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('card_fidgets.png') %>" alt="Pop-It">
                <span class="product-badge">Specials</span>
              </div>
              <div class="product-info">
                <span class="product-cat">Fidgets</span>
                <h3 class="product-title">Branded Stress-Relieving Sensory Pop-It Game Card</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$3.49</span>
                  </div>
                  <span class="product-qty">Min: 100 pcs</span>
                </div>
              </div>
            </div>
            <!-- 4 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('card_gifts.png') %>" alt="Gifts">
              </div>
              <div class="product-info">
                <span class="product-cat">Gifts</span>
                <h3 class="product-title">Premium Gourmet Wine & Artisan Snack Celebration Basket</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$89.99</span>
                  </div>
                  <span class="product-qty">Min: 5 pcs</span>
                </div>
              </div>
            </div>
            <!-- 5 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('card_drinkware.png') %>" alt="Water Bottle">
              </div>
              <div class="product-info">
                <span class="product-cat">Drinkware</span>
                <h3 class="product-title">Eco-Friendly Sporty Aluminum Vacuum Water Bottle</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$9.99</span>
                  </div>
                  <span class="product-qty">Min: 50 pcs</span>
                </div>
              </div>
            </div>
            <!-- 6 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('slide_apparel.png') %>" alt="Hoodie">
              </div>
              <div class="product-info">
                <span class="product-cat">Apparel</span>
                <h3 class="product-title">Unisex Midweight Cozy Fleece Pull-Over Custom Hoodie</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$34.99</span>
                  </div>
                  <span class="product-qty">Min: 12 pcs</span>
                </div>
              </div>
            </div>
            <!-- 7 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('card_fidgets.png') %>" alt="Novelties">
              </div>
              <div class="product-info">
                <span class="product-cat">Novelties</span>
                <h3 class="product-title">Mini Color-Changing Rainbow Fidget Ball Keychains</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$1.99</span>
                  </div>
                  <span class="product-qty">Min: 150 pcs</span>
                </div>
              </div>
            </div>
            <!-- 8 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('card_gifts.png') %>" alt="Gift Set">
              </div>
              <div class="product-info">
                <span class="product-cat">Gifts</span>
                <h3 class="product-title">Executive Leather Journal, Stylus Pen & Tumbler Gift Set</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$45.00</span>
                  </div>
                  <span class="product-qty">Min: 10 pcs</span>
                </div>
              </div>
            </div>
            <!-- 9 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('slide_apparel.png') %>" alt="Tote Bag">
              </div>
              <div class="product-info">
                <span class="product-cat">Bags & Totes</span>
                <h3 class="product-title">100% Organic Heavy Cotton Canvas Shopping Tote Bag</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$5.99</span>
                  </div>
                  <span class="product-qty">Min: 100 pcs</span>
                </div>
              </div>
            </div>
            <!-- 10 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('card_fidgets.png') %>" alt="Pen">
              </div>
              <div class="product-info">
                <span class="product-cat">Desk Accessories</span>
                <h3 class="product-title">Comfort-Grip Metallic Ballpoint Stylus Touchscreen Pen</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$0.89</span>
                  </div>
                  <span class="product-qty">Min: 250 pcs</span>
                </div>
              </div>
            </div>
            <!-- 11 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('card_drinkware.png') %>" alt="Speaker">
              </div>
              <div class="product-info">
                <span class="product-cat">Technology</span>
                <h3 class="product-title">Compact Waterproof Portable Bluetooth Travel Speaker</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$19.99</span>
                  </div>
                  <span class="product-qty">Min: 25 pcs</span>
                </div>
              </div>
            </div>
            <!-- 12 -->
            <div class="product-card">
              <div class="product-image-wrapper">
                <img src="<%= image_path('card_drinkware.png') %>" alt="Desk Camp Mug">
              </div>
              <div class="product-info">
                <span class="product-cat">Drinkware</span>
                <h3 class="product-title">Insulated Stainless Steel Desk Camp Mug with Lid</h3>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="price-now">$14.99</span>
                  </div>
                  <span class="product-qty">Min: 36 pcs</span>
                </div>
              </div>
            </div>
          </div>
        <% else %>
          <!-- No Products Found State -->
          <div style="text-align: center; padding: 80px 20px; background: var(--light-surface); border: 1px solid var(--light-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); max-width: 600px; margin: 40px auto;">
            <span class="material-symbols-outlined" style="font-size: 72px; color: #cbd5e1; margin-bottom: 16px;">production_quantity_limits</span>
            <h2 style="font-family: var(--font-display); font-weight: 800; font-size: 22px; color: var(--text-dark); margin-bottom: 8px;">No Products Found</h2>
            <p style="font-size: 14px; color: var(--text-muted); max-width: 320px; margin: 0 auto 24px auto; line-height: 1.6;">
              We couldn't find any products matching your filters. Try selecting another category or resetting your query.
            </p>
            <a href="/products" class="btn-primary">Reset Filters</a>
          </div>
        <% end %>
      <% end %>

      <!-- Pagination Controls (Always displayed by default) -->
      <div class="pagination-wrapper" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--light-border);">
        <!-- Previous Page Link -->
        <% if @current_page > 1 %>
          <a href="/products?page=<%= @current_page - 1 %>&per_page=<%= @per_page %><%= "&category=#{u(params[:category])}" if params[:category].present? %><%= "&q=#{u(params[:q])}" if params[:q].present? %>" class="pagination-btn" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); color: var(--text-dark); background: var(--light-surface); transition: var(--transition);">
            <span class="material-symbols-outlined" style="font-size: 20px;">chevron_left</span>
          </a>
        <% else %>
          <div class="pagination-btn disabled" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); color: #cbd5e1; background: #f1f5f9; cursor: not-allowed; opacity: 0.6;">
            <span class="material-symbols-outlined" style="font-size: 20px;">chevron_left</span>
          </div>
        <% end %>

        <!-- Page Numbers -->
        <% (1..@total_pages).each do |num| %>
          <% is_active = num == @current_page %>
          <% if is_active %>
            <div class="pagination-btn active" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--primary); border-radius: var(--radius-sm); color: var(--text-light); background: var(--primary); font-weight: 700; font-family: var(--font-display);"><%= num %></div>
          <% else %>
            <a href="/products?page=<%= num %>&per_page=<%= @per_page %><%= "&category=#{u(params[:category])}" if params[:category].present? %><%= "&q=#{u(params[:q])}" if params[:q].present? %>" class="pagination-btn" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); color: var(--text-dark); background: var(--light-surface); font-weight: 600; font-family: var(--font-display); transition: var(--transition);" onmouseover="this.style.background='var(--primary-light)'; this.style.color='var(--primary)'" onmouseout="this.style.background='var(--light-surface)'; this.style.color='var(--text-dark)'"><%= num %></a>
          <% end %>
        <% end %>

        <!-- Next Page Link -->
        <% if @current_page < @total_pages %>
          <a href="/products?page=<%= @current_page + 1 %>&per_page=<%= @per_page %><%= "&category=#{u(params[:category])}" if params[:category].present? %><%= "&q=#{u(params[:q])}" if params[:q].present? %>" class="pagination-btn" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); color: var(--text-dark); background: var(--light-surface); transition: var(--transition);">
            <span class="material-symbols-outlined" style="font-size: 20px;">chevron_right</span>
          </a>
        <% else %>
          <div class="pagination-btn disabled" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); color: #cbd5e1; background: #f1f5f9; cursor: not-allowed; opacity: 0.6;">
            <span class="material-symbols-outlined" style="font-size: 20px;">chevron_right</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Footer Section -->
<footer class="dcFooter" id="footer">
  <div class="container-custom footer-grid">
    <!-- Brand Info -->
    <div class="footer-col-brand">
      <div class="footer-logo">
        <img src="<%= image_path('logo_zevi.png') %>" alt="Zevi Promotion Logo">
        <span>Zevi <span>Promotion</span></span>
      </div>
      <p>Your one-stop source for premium promotional apparel, corporate gifts, spirit items, and custom-branded marketing giveaways.</p>
      <div style="font-size: 12px; color: #64748b;">Powered by Alchemy CMS & Rails 8.1</div>
    </div>

    <!-- Sitemap Navigation Links -->
    <div>
      <div class="footer-col-title">Quick Links</div>
      <ul class="footer-links">
        <li><a href="/">Home</a></li>
        <li><a href="/products">Product Catalog</a></li>
        <li><a href="/#about">About Us</a></li>
        <li><a href="#footer">Contact Us</a></li>
      </ul>
    </div>

    <!-- Contact address -->
    <div>
      <div class="footer-col-title">Contact Us</div>
      <address class="footer-contact-address">
        <div class="footer-contact-item" style="font-weight: 700; color: var(--text-light);">
          <span>Zevi Promotions Inc.</span>
        </div>
        <div class="footer-contact-item">
          <span class="icon material-symbols-outlined">business</span>
          <span>1434 W Taft Ave, Suite 335<br>Orange, CA 92865</span>
        </div>

        <div class="footer-contact-item">
          <span class="icon material-symbols-outlined">call</span>
          <span><%= phone_number %></span>
        </div>
        <div class="footer-contact-item">
          <span class="icon material-symbols-outlined">mail</span>
          <a href="mailto:<%= email_address %>"><%= email_address %></a>
        </div>
      </address>
    </div>
  </div>

  <div class="container-custom footer-bottom">
    <p>&copy; <%= Time.current.year %> Zevi Promotion. All rights reserved.</p>
    <div class="footer-bottom-links">
      <a href="javascript:void(0)">Privacy Policy</a>
      <a href="javascript:void(0)">Terms & Conditions</a>
    </div>
  </div>
</footer>

<!-- Floating Email Widget -->
<div id="floating-email-widget" class="floating-email-box minimized">
  <a href="mailto:<%= email_address %>" class="widget-action-btn email-btn">
    <span class="material-symbols-outlined">mail</span>
    <span class="btn-label">Email</span>
  </a>
  <button type="button" id="widget-toggle-btn" class="widget-action-btn toggle-btn">
    <span class="material-symbols-outlined toggle-icon">keyboard_arrow_down</span>
    <span class="btn-label toggle-label">Hide</span>
  </button>
</div>

<button type="button" id="floating-email-collapsed" class="floating-email-collapsed-btn" style="display: flex;">
  <span class="material-symbols-outlined">mail</span>
</button>


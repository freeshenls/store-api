<!-- 2. Trending Products Section -->
<section class="py-10 md:py-16" id="products">
  <div class="<%= container_custom %>">
    <div class="text-center mb-6">
      <h2 class="text-[26px] font-bold text-[#0f172a] mb-2.5 font-['Outfit']">Trending Products</h2>
      <hr class="border-0 h-[3px] bg-[#074277] w-[60px] mx-auto">
    </div>

    <div class="relative mx-auto px-0 md:px-12 max-w-full" data-controller="product-slider" data-action="touchstart->product-slider#touchStart touchmove->product-slider#touchMove touchend->product-slider#touchEnd resize@window->product-slider#adjustPosition">
      <!-- Left Navigation Arrow -->
      <button class="absolute top-1/2 -translate-y-1/2 left-0 w-10 h-10 rounded-full bg-white border border-[#e2e8f0] text-[#0f172a] hidden md:flex items-center justify-center cursor-pointer shadow-md z-10 transition-all duration-300 hover:bg-[#074277] hover:text-white hover:border-[#074277]" data-action="click->product-slider#prev" aria-label="Slide left">
        <%= heroicon "chevron-left" %>
      </button>
      
      <div class="overflow-visible md:overflow-hidden w-full">
        <div class="flex flex-col md:flex-row gap-4 md:gap-6 transition-transform duration-400 ease-[cubic-bezier(0.25,1,0.5,1)]" data-product-slider-target="track" style="transform: translateX(0px);">
          <% if @trending_products.any? %>
            <% @trending_products.each do |product| %>
            <div class="flex shrink-0 w-full md:w-[calc((100%-24px*2)/3)] lg:w-[calc((100%-24px*3)/4)]" data-product-slider-target="item">
              <%
                product_link = "/products/#{product.guid}/#{product.slug}"
                product_title = product.title
                product_price = product.price
                product_min_qty = product.min_qty
                
                # Resolve images
                images_list = []
                if product.images.attached?
                  product.images.each do |img|
                    begin
                      images_list << url_for(img) if img.blob.present?
                    rescue
                    end
                  end
                end
                images_list << product.main_image_url if images_list.empty? && product.main_image_url.present?
                if product.image_urls.is_a?(Array)
                  product.image_urls.each { |url| images_list << url unless images_list.include?(url) }
                end
                product_img_url = images_list.first || "/placeholder.png"
              %>
              <a class="cursor-pointer block no-underline text-inherit h-full w-full" href="<%= product_link %>">
                <div class="bg-white border border-[#e2e8f0] rounded-[12px] p-4 flex flex-col items-center text-center transition-all duration-300 h-full hover:shadow-md hover:border-[#074277]">
                  <% if product_img_url %>
                    <img src="<%= product_img_url %>" alt="<%= product_title %>" class="h-[100px] w-[100px] object-contain mb-3">
                  <% else %>
                    <div class="w-full h-[100px] flex items-center justify-center bg-[#f1f5f9] text-[#94a3b8] text-[11px] mb-3">No Image</div>
                  <% end %>
                  
                  <div class="text-[#074277] font-semibold mb-1 font-['Outfit'] text-[13px] leading-[1.35] line-clamp-2 overflow-hidden h-[35px]">
                    <%= product_title %>
                  </div>
                  
                  <div class="text-[11px] text-[#64748b] leading-normal font-['Inter'] mt-auto pt-1 text-center">
                    <div class="text-[#0f172a] font-medium">
                      <%= product_min_qty %> @ <%= product_price %>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          <% end %>
          <% else %>
            <div class="text-center p-10 text-[#64748b] text-sm w-full">
              No products available at the moment.
            </div>
          <% end %>
        </div>
      </div>

      <!-- Right Navigation Arrow -->
      <button class="absolute top-1/2 -translate-y-1/2 right-0 w-10 h-10 rounded-full bg-white border border-[#e2e8f0] text-[#0f172a] hidden md:flex items-center justify-center cursor-pointer shadow-md z-10 transition-all duration-300 hover:bg-[#074277] hover:text-white hover:border-[#074277]" data-action="click->product-slider#next" aria-label="Slide right">
        <%= heroicon "chevron-right" %>
      </button>
    </div>

    <div class="text-center mt-8">
      <a href="/products" class="<%= btn_secondary %>">
        <span>View All Products</span>
        <%= heroicon "arrow-right", options: { class: "size-4" } %>
      </a>
    </div>
  </div>
</section>


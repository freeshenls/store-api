    <!-- Product Slider Control Script -->
    <script>
      (function() {
        function initProductSlider() {
          const track = document.getElementById("productSliderTrack");
          if (!track) return;

          // Reset slide position
          if (window.innerWidth <= 768) {
            track.style.transform = "none";
          } else {
            track.style.transform = "translateX(0px)";
          }
          track.dataset.currentIndex = "0";

          window.adjustProductSlidePosition = function() {
            const track = document.getElementById("productSliderTrack");
            if (!track) return;
            if (window.innerWidth <= 768) {
              track.style.transform = "none";
              return;
            }
            const items = track.querySelectorAll(".slider-item");
            if (items.length === 0) return;

            const gap = 24;
            const itemWidth = items[0].getBoundingClientRect().width + gap;
            const currentIndex = parseInt(track.dataset.currentIndex || "0");
            const offset = -currentIndex * itemWidth;
            track.style.transform = `translateX(${offset}px)`;
          };

          window.slideProducts = function(direction) {
            if (window.innerWidth <= 768) return; // Disable horizontal slide on mobile
            const track = document.getElementById("productSliderTrack");
            if (!track) return;

            const items = track.querySelectorAll(".slider-item");
            if (items.length === 0) return;

            const gap = 24;
            const itemWidth = items[0].getBoundingClientRect().width + gap; // Width of card + gap
            const containerWidth = track.parentElement.getBoundingClientRect().width;
            
            let currentIndex = parseInt(track.dataset.currentIndex || "0");
            const visibleCount = Math.round(containerWidth / itemWidth);
            const maxIndex = Math.max(0, items.length - visibleCount);

            if (direction === "next") {
              if (currentIndex < maxIndex) {
                currentIndex++;
              } else {
                currentIndex = 0; // Wrap back to start
              }
            } else if (direction === "prev") {
              if (currentIndex > 0) {
                currentIndex--;
              } else {
                currentIndex = maxIndex; // Wrap to end
              }
            }

            track.dataset.currentIndex = currentIndex.toString();
            if (typeof window.adjustProductSlidePosition === "function") {
              window.adjustProductSlidePosition();
            }
          };

          // Touch Swipe Support for Products Slider
          const productWrapper = document.querySelector(".product-slider-wrapper");
          if (productWrapper && !productWrapper.dataset.swipeRegistered) {
            let startX = 0;
            let endX = 0;
            
            productWrapper.addEventListener("touchstart", function(e) {
              startX = e.touches[0].clientX;
              endX = e.touches[0].clientX; // Defensive initialization
            }, { passive: true });
            
            productWrapper.addEventListener("touchmove", function(e) {
              endX = e.touches[0].clientX;
            }, { passive: true });
            
            productWrapper.addEventListener("touchend", function() {
              if (window.innerWidth <= 768) return; // Disable swipe actions when stacked vertically on mobile
              const threshold = 40;
              const diff = startX - endX;
              if (Math.abs(diff) > threshold) {
                if (diff > 0) {
                  // Swipe left -> slide to next products
                  if (typeof window.slideProducts === "function") {
                    window.slideProducts("next");
                  }
                } else {
                  // Swipe right -> slide to prev products
                  if (typeof window.slideProducts === "function") {
                    window.slideProducts("prev");
                  }
                }
              }
              startX = 0;
              endX = 0;
            });
            
            productWrapper.dataset.swipeRegistered = "true";
          }
        }

        // Register resize handler once globally
        if (!window.productSliderResizeRegistered) {
          window.addEventListener("resize", function() {
            if (typeof window.adjustProductSlidePosition === "function") {
              window.adjustProductSlidePosition();
            }
          });
          window.productSliderResizeRegistered = true;
        }

        // Run on Turbo load
        document.addEventListener("turbo:load", initProductSlider);
        
        // DOMContentLoaded fallback
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initProductSlider);
        } else {
          initProductSlider();
        }
      })();
    </script>


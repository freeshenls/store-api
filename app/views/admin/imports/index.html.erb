<% content_for :admin_title, "Product Importer" %>
<div style="display: flex; flex-direction: column; gap: 32px;">

    <!-- Alert Messages -->
    <% if flash[:notice].present? %>
      <div style="padding: 16px 20px; background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: var(--radius-md); color: #065f46; font-size: 14px; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined">check_circle</span>
        <span><%= flash[:notice] %></span>
      </div>
    <% end %>
    
    <% if flash[:alert].present? %>
      <div style="padding: 16px 20px; background-color: #fef2f2; border: 1px solid #fecaca; border-radius: var(--radius-md); color: #991b1b; font-size: 14px; display: flex; align-items: center; gap: 8px; white-space: pre-wrap;">
        <span class="material-symbols-outlined">error</span>
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <!-- Twin Grid: Uploader on Left, Schema Template on Right -->
    <div class="artwork-tips-layout">
      
      <!-- Left Column: Excel Drag & Drop Upload -->
      <div class="artwork-tips-main">
        <div style="background: #ffffff; border: 1px solid var(--light-border); border-radius: var(--radius-lg); padding: 32px; box-shadow: var(--shadow-sm);">
          <h2 style="font-family: var(--font-display); font-weight: 700; font-size: 18px; color: var(--text-dark); margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined" style="color: var(--primary);">upload_file</span>
            <span>Upload ESP Excel File</span>
          </h2>
          
          <%= form_with url: admin_imports_path, method: :post, local: true, multipart: true do |form| %>
            <div style="border: 2px dashed #cbd5e1; border-radius: var(--radius-md); padding: 40px 20px; text-align: center; background-color: var(--light-bg); transition: var(--transition); cursor: pointer;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='#cbd5e1'">
              <span class="material-symbols-outlined" style="font-size: 48px; color: #94a3b8; margin-bottom: 12px; display: block;">cloud_upload</span>
              <span style="font-size: 14px; font-weight: 600; color: var(--text-dark); display: block; margin-bottom: 8px;">Select Excel Workbook file to import</span>
              <span style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 20px;">Supports standard spreadsheet (.xlsx) formats only</span>
              
              <div style="display: inline-block; position: relative;">
                <%= form.file_field :file, accept: ".xlsx", style: "cursor: pointer; opacity: 0; position: absolute; left: 0; top: 0; width: 100%; height: 100%;" %>
                <button type="button" class="nav-pill" style="pointer-events: none; border-color: var(--primary); color: var(--primary); font-weight: 700;">Choose File</button>
              </div>
            </div>

            <div style="margin-top: 24px; display: flex; justify-content: flex-end;">
              <button type="submit" class="btn-primary" style="padding: 12px 32px; border: none; font-size: 15px;">
                <span class="material-symbols-outlined">import_contacts</span>
                <span>Start Import Process</span>
              </button>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Right Column: Schema/Template specifications -->
      <aside class="artwork-tips-sidebar" style="width: 320px;">
        <div style="background: #ffffff; border: 1px solid var(--light-border); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm); height: 100%;">
          <h2 style="font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--text-dark); margin: 0 0 12px 0; border-bottom: 1px solid var(--light-border); padding-bottom: 8px;">Template Specifications</h2>
          <p style="font-size: 13px; color: var(--text-muted); line-height: 1.5; margin-bottom: 16px;">Make sure your Excel sheet contains the following exact column headers in row 1:</p>
          
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: 12px; line-height: 1.4;">
            <li>
              <strong style="color: var(--primary);">cpn</strong> (Required)
              <p style="color: var(--text-muted); margin: 2px 0 0 0;">Supplier product SKU/CPN code.</p>
            </li>
            <li>
              <strong style="color: var(--primary);">title</strong> (Required)
              <p style="color: var(--text-muted); margin: 2px 0 0 0;">Product title / name.</p>
            </li>
            <li>
              <strong>category</strong>
              <p style="color: var(--text-muted); margin: 2px 0 0 0;">Apparel, Drinkware, Fidgets, etc.</p>
            </li>
            <li>
              <strong>price</strong>
              <p style="color: var(--text-muted); margin: 2px 0 0 0;">Price string, e.g. "$0.25 and up".</p>
            </li>
            <li>
              <strong>min_qty</strong>
              <p style="color: var(--text-muted); margin: 2px 0 0 0;">MOQ limit string, e.g. "Min: 50 pcs".</p>
            </li>
            <li>
              <strong>image_url_1 ... 5</strong>
              <p style="color: var(--text-muted); margin: 2px 0 0 0;">Direct web image urls to download/attach.</p>
            </li>
            <li>
              <strong>product_detail, imprint...</strong>
              <p style="color: var(--text-muted); margin: 2px 0 0 0;">HTML rich specification text strings.</p>
            </li>
          </ul>
        </div>
      </aside>
    </div>

    <!-- Bottom Section: Currently Active Products List -->
    <div style="background: #ffffff; border: 1px solid var(--light-border); border-radius: var(--radius-lg); padding: 32px; box-shadow: var(--shadow-sm); margin-top: 16px;">
      <h2 style="font-family: var(--font-display); font-weight: 700; font-size: 18px; color: var(--text-dark); margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined" style="color: var(--primary);">table_chart</span>
        <span>Active Catalog Products (<%= @total_products %>)</span>
      </h2>
      
      <% if @products.any? %>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: left;">
            <thead>
              <tr style="border-bottom: 2px solid var(--light-border); background-color: var(--light-bg); color: var(--text-dark); font-weight: 700;">
                <th style="padding: 12px 16px;">Image</th>
                <th style="padding: 12px 16px;">CPN</th>
                <th style="padding: 12px 16px;">Title</th>
                <th style="padding: 12px 16px;">Category</th>
                <th style="padding: 12px 16px;">Price</th>
                <th style="padding: 12px 16px;">Min Qty</th>
                <th style="padding: 12px 16px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @products.each do |product| %>
                <tr style="border-bottom: 1px solid var(--light-border); hover:background-color: var(--light-bg); transition: var(--transition);">
                  <td style="padding: 12px 16px;">
                    <% if product.images.attached? %>
                      <img src="<%= url_for(product.images.first) %>" alt="<%= product.title %>" style="width: 48px; height: 48px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--light-border);">
                    <% else %>
                      <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background-color: var(--light-bg); border-radius: var(--radius-sm); color: var(--text-muted); font-size: 10px; border: 1px solid var(--light-border);">No Image</div>
                    <% end %>
                  </td>
                  <td style="padding: 12px 16px; font-weight: 700; color: var(--primary);"><%= product.cpn %></td>
                  <td style="padding: 12px 16px; font-weight: 600; color: var(--text-dark);"><%= product.title %></td>
                  <td style="padding: 12px 16px;"><span class="badge-success" style="font-size: 11px; padding: 4px 8px; border-radius: 12px;"><%= product.category %></span></td>
                  <td style="padding: 12px 16px; font-weight: 700;"><%= product.price %></td>
                  <td style="padding: 12px 16px; color: var(--text-muted);"><%= product.min_qty %></td>
                  <td style="padding: 12px 16px;">
                    <a href="/products/<%= product.slug %>" target="_blank" style="color: var(--primary); text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                      <span>Preview</span>
                      <span class="material-symbols-outlined" style="font-size: 14px;">open_in_new</span>
                    </a>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Sliding Window Pagination -->
        <% if @total_pages > 1 %>
          <div style="padding-top: 24px; margin-top: 20px; border-top: 1px solid var(--light-border); display: flex; align-items: center; justify-content: space-between;">
            <div style="font-size: 12px; color: var(--text-muted);">
              Showing Page <strong><%= @current_page %></strong> of <strong><%= @total_pages %></strong>
            </div>
            
            <div class="stepper-nav" style="gap: 4px;">
              <% if @current_page > 1 %>
                <a href="/admin/imports?page=<%= @current_page - 1 %>" class="btn-back" style="padding: 6px 12px; font-size: 12px; height: auto; text-decoration: none; border-radius: 4px; display: inline-flex; align-items: center; gap: 4px; color: var(--text-dark); background: #ffffff; border: 1px solid var(--light-border);">
                  <span class="material-symbols-outlined" style="font-size: 14px;">chevron_left</span>
                  <span>Prev</span>
                </a>
              <% end %>

              <%
                # Dynamic Sliding Window: show at most 3 page squares
                page_window = 3
                half_window = page_window / 2
                
                start_page = @current_page - half_window
                end_page = @current_page + half_window
                
                if start_page < 1
                  end_page = [end_page + (1 - start_page), @total_pages].min
                  start_page = 1
                elsif end_page > @total_pages
                  start_page = [start_page - (end_page - @total_pages), 1].max
                  end_page = @total_pages
                end
              %>
              
              <% (start_page..end_page).each do |p| %>
                <% is_current = p == @current_page %>
                <a href="/admin/imports?page=<%= p %>" style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border: 1px solid <%= is_current ? 'var(--primary)' : 'var(--light-border)' %>; border-radius: 4px; font-size: 12px; font-weight: 700; text-decoration: none; background-color: <%= is_current ? 'var(--primary)' : '#ffffff' %>; color: <%= is_current ? '#ffffff' : 'var(--text-dark)' %>;">
                  <%= p %>
                </a>
              <% end %>

              <% if @current_page < @total_pages %>
                <a href="/admin/imports?page=<%= @current_page + 1 %>" class="btn-next" style="padding: 6px 12px; font-size: 12px; height: auto; text-decoration: none; border-radius: 4px; display: inline-flex; align-items: center; gap: 4px; color: #ffffff; background: var(--primary);">
                  <span>Next</span>
                  <span class="material-symbols-outlined" style="font-size: 14px;">chevron_right</span>
                </a>
              <% end %>
            </div>
          </div>
        <% end %>

      <% else %>
        <div style="text-align: center; padding: 40px; color: var(--text-muted);">
          <span class="material-symbols-outlined" style="font-size: 48px; color: #cbd5e1; margin-bottom: 8px; display: block;">playlist_remove</span>
          <span>No products found in the database. Use the uploader above to import your first spreadsheet!</span>
        </div>
      <% end %>
    </div>

  </div>

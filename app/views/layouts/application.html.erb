<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Zevi Promotion - Custom Swag & Promotional Products" %></title>
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Welcome to Zevi Promotion - Your ultimate destination for premium custom promotional products, corporate gifts, embroidered apparel, and graphic artwork services." %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Zevi Promotion">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">


    <%# Include stylesheet compiled by esbuild %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>




  </head>

  <body>
    <%= yield %>
  </body>
</html>

<div class="min-h-screen flex items-center justify-center bg-[#0f172a] font-sans p-5 box-border">
  
  <div class="bg-[#1e293b]/70 border border-[#334155] backdrop-blur-md rounded-[20px] py-12 px-10 w-full max-w-[440px] shadow-[0_20px_25px_-5px_rgba(0,0,0,0.3),0_10px_10px_-5px_rgba(0,0,0,0.2)] box-border">
    
    <!-- Zevi Admin Logo -->
    <div class="text-center mb-8">
      <%= heroicon "shield-check", options: { class: "text-[56px] text-[#b93530] block mx-auto mb-3" } %>
      <h1 class="font-['Outfit'] font-extrabold text-[26px] text-white m-0">Zevi Admin Portal</h1>
      <p class="text-[13px] text-[#94a3b8] mt-1.5 mb-0 mx-0">Please sign in to access the uploader dashboard</p>
    </div>

    <!-- Alert and Notice handlers -->
    <% if alert = flash[:alert] %>
      <div class="py-3 px-4 bg-red-500/15 border border-red-500/30 rounded-[6px] text-[#fca5a5] text-[13px] mb-6 flex items-center gap-2">
        <%= heroicon "exclamation-circle", options: { class: "size-4" } %>
        <span><%= alert %></span>
      </div>
    <% end %>

    <% if notice = flash[:notice] %>
      <div class="py-3 px-4 bg-green-500/15 border border-green-500/30 rounded-[6px] text-[#86efac] text-[13px] mb-6 flex items-center gap-2">
        <%= heroicon "check-circle", options: { class: "size-4" } %>
        <span><%= notice %></span>
      </div>
    <% end %>

    <%= form_with url: session_url, local: true do |form| %>
      
      <!-- Email field -->
      <div class="mb-5">
        <label for="email_address" class="block text-xs font-semibold text-[#94a3b8] uppercase tracking-wider mb-2">Email Address</label>
        <%= form.email_field :email_address, id: "email_address", required: true, autofocus: true, autocomplete: "username", placeholder: "admin@zevipromotions.com", value: params[:email_address], class: "w-full box-border bg-[#0f172a]/60 border border-[#334155] rounded-[6px] py-3 px-4 text-sm text-white outline-none transition-all duration-300 focus:border-[#074277]" %>
      </div>

      <!-- Password field -->
      <div class="mb-6">
        <div class="flex justify-between items-center mb-2">
          <label for="password" class="block text-xs font-semibold text-[#94a3b8] uppercase tracking-wider m-0">Password</label>
          <%= link_to "Forgot?", new_password_path, class: "text-xs text-blue-400 no-underline hover:underline" %>
        </div>
        <%= form.password_field :password, id: "password", required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72, class: "w-full box-border bg-[#0f172a]/60 border border-[#334155] rounded-[6px] py-3 px-4 text-sm text-white outline-none transition-all duration-300 focus:border-[#074277]" %>
      </div>

      <!-- Submit button -->
      <div class="mt-8">
        <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-[#074277] text-white py-3.5 px-5 rounded-[12px] font-['Outfit'] font-bold text-[15px] border-none shadow-[0_4px_14px_rgba(7,66,119,0.25)] cursor-pointer transition-all duration-300 hover:bg-[#052e54] hover:-translate-y-0.5">
          <%= heroicon "arrow-right-on-rectangle", options: { class: "size-[18px]" } %>
          <span>Sign In to Dashboard</span>
        </button>
      </div>

    <% end %>

    <!-- Back to storefront link -->
    <div class="text-center mt-6 border-t border-[#334155] pt-4">
      <a href="/" class="text-[13px] text-[#94a3b8] no-underline inline-flex items-center gap-1 hover:text-white transition-colors duration-200">
        <%= heroicon "arrow-left", options: { class: "size-4" } %>
        <span>Back to Storefront</span>
      </a>
    </div>

  </div>

</div>

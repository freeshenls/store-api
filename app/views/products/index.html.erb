<%
  # Set up category fallbacks in case the database is in an empty state
  categories = @categories.any? ? @categories : [
    "Apparel",
    "Desk Accessories",
    "Drinkware",
    "Fidgets",
    "Novelties",
    "Gifts",
    "Bags & Totes",
    "Technology"
  ]

  # Retrieve unified contact details from Alchemy Layout Pages (Global Pages)
  global_page = Alchemy::Page.layoutpages.find_by(page_layout: 'global_layout')


  header_contact = global_page&.elements&.find_by(name: 'header_contact')
  
  # Fallback to local page element if global is not yet created/published in the editor
  header_contact ||= @page.elements.find_by(name: 'header_contact') if @page
  
  phone_number = header_contact&.value_for('phone').presence || "(714) 857-0010"
  email_address = header_contact&.value_for('email').presence || "sales@zevipromotion.com"
%>

<%= render "shared/top_contact_bar" %>
<%= render "shared/main_header" %>


<!-- Main Products Content Grid -->
<section class="hero-layout-section">
  <div class="container-custom hero-grid">
    <!-- Left Sidebar Category Filters -->
    <%
      # Helper to build category links that preserve other active query filters (search, price, page limits)
      def category_filter_url(cat = nil)
        url_parts = []
        url_parts << "category=#{u(cat)}" if cat.present?
        url_parts << "q=#{u(params[:q])}" if params[:q].present?
        url_parts << "min_price=#{params[:min_price]}" if params[:min_price].present?
        url_parts << "max_price=#{params[:max_price]}" if params[:max_price].present?
        url_parts << "per_page=#{params[:per_page]}" if params[:per_page].present?
        "/products" + (url_parts.any? ? "?" + url_parts.join("&") : "")
      end
    %>
    <aside class="categories-sidebar">
      <div class="sidebar-title" id="filter-toggle-btn" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center; width: 100%;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="material-symbols-outlined" style="font-size: 20px; color: var(--primary);">grid_view</span>
          <span>Categories</span>
        </div>
        <span class="material-symbols-outlined filter-arrow-icon" style="font-size: 20px; transition: transform 0.3s; display: none;">keyboard_arrow_down</span>
      </div>
      <ul class="sidebar-menu-list">
        <li class="sidebar-menu-item <%= 'active' unless params[:category].present? %>">
          <a href="<%= category_filter_url(nil) %>">
            <span>All Products</span>
            <span class="material-symbols-outlined" style="font-size: 16px;">chevron_right</span>
          </a>
        </li>
        <% categories.each do |cat| %>
          <% is_active = params[:category].to_s.downcase == cat.downcase %>
          <li class="sidebar-menu-item <%= 'active' if is_active %>">
            <a href="<%= category_filter_url(cat) %>">
              <span><%= cat %></span>
              <span class="material-symbols-outlined" style="font-size: 16px;">chevron_right</span>
            </a>
          </li>
        <% end %>
      </ul>

      <!-- Price Range Filter Form -->
      <div class="price-filter-form" style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--light-border);">
        <h4 style="font-family: var(--font-display); font-size: 15px; font-weight: 800; color: var(--text-dark); margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
          <span class="material-symbols-outlined" style="font-size: 18px; color: var(--primary);">payments</span>
          <span>Price Range</span>
        </h4>
        <form action="/products" method="GET" style="display: flex; flex-direction: column; gap: 12px;">
          <!-- Retain existing filters as hidden inputs -->
          <% if params[:category].present? %>
            <input type="hidden" name="category" value="<%= params[:category] %>">
          <% end %>
          <% if params[:q].present? %>
            <input type="hidden" name="q" value="<%= params[:q] %>">
          <% end %>
          <% if params[:per_page].present? %>
            <input type="hidden" name="per_page" value="<%= params[:per_page] %>">
          <% end %>

          <div style="display: flex; align-items: center; gap: 8px;">
            <input type="number" name="min_price" step="any" min="0" placeholder="Min" value="<%= params[:min_price] %>" style="width: 100%; height: 36px; padding: 6px 10px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); font-size: 13px; font-family: var(--font-body); outline: none; background: var(--light-bg); transition: border-color 0.2s;" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='var(--light-border)'">
            <span style="color: var(--text-muted); font-size: 13px;">to</span>
            <input type="number" name="max_price" step="any" min="0" placeholder="Max" value="<%= params[:max_price] %>" style="width: 100%; height: 36px; padding: 6px 10px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); font-size: 13px; font-family: var(--font-body); outline: none; background: var(--light-bg); transition: border-color 0.2s;" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='var(--light-border)'">
          </div>

          <div style="display: flex; gap: 8px;">
            <button type="submit" style="flex: 1; height: 36px; background-color: var(--primary); color: #fff; border: none; border-radius: var(--radius-sm); font-size: 13px; font-family: var(--font-display); font-weight: 700; cursor: pointer; transition: var(--transition);" onmouseover="this.style.backgroundColor='var(--primary-hover)'" onmouseout="this.style.backgroundColor='var(--primary)'">Apply</button>
            <% if params[:min_price].present? || params[:max_price].present? %>
              <%
                # Clear url helper preserving other parameters
                url_clear_parts = []
                url_clear_parts << "category=#{u(params[:category])}" if params[:category].present?
                url_clear_parts << "q=#{u(params[:q])}" if params[:q].present?
                url_clear_parts << "per_page=#{params[:per_page]}" if params[:per_page].present?
                clear_price_url = "/products" + (url_clear_parts.any? ? "?" + url_clear_parts.join("&") : "")
              %>
              <a href="<%= clear_price_url %>" style="display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); color: var(--text-muted); transition: var(--transition);" title="Clear Price Filter" onmouseover="this.style.color='var(--highlight-red)'; this.style.borderColor='var(--highlight-red)'" onmouseout="this.style.color='var(--text-muted)'; this.style.borderColor='var(--light-border)'">
                <span class="material-symbols-outlined" style="font-size: 18px;">backspace</span>
              </a>
            <% end %>
          </div>
        </form>
      </div>
    </aside>

    <!-- Right Products List Grid -->
    <div>
      <!-- Page Header & Search Feedback -->
      <div style="margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; border-bottom: 1px solid var(--light-border); padding-bottom: 16px;">
        <div>
          <h1 style="font-family: var(--font-display); font-size: 28px; font-weight: 800; color: var(--text-dark);">
            <%= @category_filter.present? ? @category_filter : "Product Catalog" %>
          </h1>
          <% if @query.present? %>
            <p style="font-size: 14px; color: var(--text-muted); margin-top: 4px;">
              Showing results for "<strong style="color: var(--text-dark);"><%= @query %></strong>"
            </p>
          <% end %>
        </div>
        <div style="display: flex; align-items: center; gap: 16px; font-size: 14px; color: var(--text-muted); font-weight: 500; flex-wrap: wrap;">
          <div>
            Found <strong style="color: var(--text-dark); font-family: var(--font-display);"><%= @all_product_cards.any? ? @total_products : (params[:q].blank? && params[:category].blank? ? 12 : 0) %></strong> products
          </div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <span>Show:</span>
            <%
              def page_size_url(size)
                "/products?per_page=#{size}" +
                (params[:category].present? ? "&category=#{u(params[:category])}" : "") +
                (params[:q].present? ? "&q=#{u(params[:q])}" : "")
              end
            %>
            <select onchange="window.location.href = this.value" style="padding: 6px 12px; border: 1px solid var(--light-border); border-radius: var(--radius-sm); font-size: 13px; font-weight: 600; color: var(--text-dark); background: var(--light-surface); outline: none; cursor: pointer; transition: var(--transition);" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='var(--light-border)'">
              <option value="<%= page_size_url(15) %>" <%= 'selected' if @per_page == 15 %>>15 / Page</option>
              <option value="<%= page_size_url(30) %>" <%= 'selected' if @per_page == 30 %>>30 / Page</option>
              <option value="<%= page_size_url(60) %>" <%= 'selected' if @per_page == 60 %>>60 / Page</option>
              <option value="<%= page_size_url(120) %>" <%= 'selected' if @per_page == 120 %>>120 / Page</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Products Grid -->
      <% if @product_cards.any? %>
        <div class="product-grid">
          <% @product_cards.each do |product| %>
            <%= render "alchemy/elements/product_card", product_card: product %>
          <% end %>
        </div>
      <% else %>

<%
  # Retrieve unified contact details from Alchemy Layout Pages (Global Pages)
  global_page = Alchemy::Page.layoutpages.find_by(page_layout: 'global_layout')
  header_contact = global_page&.elements&.find_by(name: 'header_contact')
  header_contact ||= @page&.elements&.find_by(name: 'header_contact') if @page
  
  phone_number = header_contact&.value_for('phone').presence || "(714) 857-0010"
  email_address = header_contact&.value_for('email').presence || "sales@zevipromotion.com"

  # Retrieve footer menu node configured in Alchemy CMS editor
  footer_navigation = Alchemy::Node.roots.find_by(name: 'footer_menu')
%>

<!-- Footer Section -->
<footer class="dcFooter" id="footer">
  <div class="container-custom footer-grid">
    <!-- Brand Info -->
    <div class="footer-col-brand">
      <div class="footer-logo">
        <img src="<%= image_path('logo_zevi.png') %>" alt="Zevi Promotion Logo">
        <span>Zevi <span>Promotion</span></span>
      </div>
      <p>Your one-stop source for premium promotional apparel, corporate gifts, spirit items, and custom-branded marketing giveaways.</p>
      <div style="font-size: 12px; color: #64748b;">Powered by Alchemy CMS & Rails 8.1</div>
    </div>

    <!-- Sitemap Navigation Links -->
    <div>
      <div class="footer-col-title">Quick Links</div>
      <ul class="footer-links">
        <% if footer_navigation && footer_navigation.children.any? %>
          <% footer_navigation.children.each do |node| %>
            <li><a href="<%= node.url %>"><%= node.name %></a></li>
          <% end %>
        <% else %>
          <li><a href="/">Home</a></li>
          <li><a href="/products">Product Catalog</a></li>
          <li><a href="/#about">About Us</a></li>
          <li><a href="#footer">Contact Us</a></li>
          <li><a href="/artwork_tips">Artwork Tips</a></li>
        <% end %>
      </ul>
    </div>

    <!-- Contact address -->
    <div>
      <div class="footer-col-title">Contact Us</div>
      <address class="footer-contact-address">
        <div class="footer-contact-item" style="font-weight: 700; color: var(--text-light);">
          <span>Zevi Promotions Inc.</span>
        </div>
        <div class="footer-contact-item">
          <span class="icon material-symbols-outlined">business</span>
          <span>1434 W Taft Ave, Suite 335<br>Orange, CA 92865</span>
        </div>

        <div class="footer-contact-item">
          <span class="icon material-symbols-outlined">call</span>
          <span><%= phone_number %></span>
        </div>

        <div class="footer-contact-item">
          <span class="icon material-symbols-outlined">mail</span>
          <span><%= email_address %></span>
        </div>
      </address>
    </div>
  </div>

  <!-- Bottom Copyright Bar -->
  <div class="footer-bottom">
    <div class="container-custom footer-bottom-flex">
      <div>&copy; <%= Time.current.year %> Zevi Promotion. All rights reserved.</div>
      <div class="footer-bottom-links">
        <a href="javascript:void(0)">Privacy Policy</a>
        <a href="javascript:void(0)">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
